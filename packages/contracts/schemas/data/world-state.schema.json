{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data/world-state.schema.json",
  "description": "Data contract 1.5: WorldState, RunFact (3.1) / データ契約 1.5：WorldState、RunFact（3.1）",
  "$ref": "#/$defs/WorldState",
  "$defs": {
    "WorldState": {
      "title": "WorldState",
      "description": "The current state derived from events, not a second source of truth (3.1): the world model's initial values + the effects of all events applied in seq order / イベントから導いた現在の状態で、2 つ目の事実ではない（3.1）：世界モデルの初期値 + 全イベントの effects を seq の順に適用したもの",
      "type": "object",
      "properties": {
        "playthroughId": {
          "$ref": "common.schema.json#/$defs/PlaythroughId"
        },
        "asOfSeq": {
          "type": "integer",
          "minimum": 0,
          "description": "Up to which event it has been derived / どのイベントまで導出したか"
        },
        "t": {
          "$ref": "common.schema.json#/$defs/StoryTime",
          "description": "Clock = max(t + dt) over all events / 時計 = 全イベントの max(t + dt)"
        },
        "vars": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/VarId"
          },
          "additionalProperties": {},
          "description": "Current values of all stateVars / すべての stateVar の現在の値"
        },
        "beats": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/BeatId"
          },
          "additionalProperties": {
            "enum": [
              "pending",
              "happened",
              "prevented",
              "delayed",
              "hastened",
              "altered"
            ]
          }
        },
        "schedule": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/BeatId"
          },
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/StoryTime"
          },
          "description": "This playthrough's scheduled times for beats that have no outcome yet (2.5.1) / まだ結果の出ていないビートの、このプレイでの予定時刻（2.5.1）"
        },
        "knowledge": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/CharacterId"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/FactId"
                },
                {
                  "$ref": "common.schema.json#/$defs/RunFactId"
                }
              ]
            }
          },
          "description": "Character → facts newly learned at runtime / 登場人物 → 実行時に新たに知った fact"
        },
        "locations": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/CharacterId"
          },
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/PlaceId"
          },
          "description": "Character → place / 登場人物 → 地点"
        },
        "spots": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/CharacterId"
          },
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/SpotId"
          },
          "description": "(1.7) Character → assigned spot: present only when a relocate specified a spot; removed when moving to another place. Characters without one are placed by the backend using the layout's placement rules (section 3.1) / （1.7）登場人物 → 指定された位置点：relocate に spot が書かれたときだけある。別の地点に移ると取り除く。ない場合はバックエンドがレイアウトの立ち位置の規則で配置する（第 3.1 節）"
        },
        "promises": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/PromiseId"
          },
          "additionalProperties": {
            "$ref": "memory.schema.json#/$defs/Promise"
          },
          "description": "(1.1) promiseId → promise / （1.1）promiseId → 約束"
        },
        "runFacts": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/RunFactId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/RunFact"
          },
          "description": "(1.1) factId → improvised fact / （1.1）factId → 即興の設定"
        },
        "holdings": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/ItemId"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "const": "player"
              },
              {
                "$ref": "common.schema.json#/$defs/CharacterId"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "(1.3) Portable item → who holds it now / （1.3）portable なアイテム → いま誰が持っているか"
        }
      },
      "required": [
        "playthroughId",
        "asOfSeq",
        "t",
        "vars",
        "beats",
        "schedule",
        "knowledge",
        "locations"
      ],
      "additionalProperties": false
    },
    "RunFact": {
      "title": "RunFact",
      "description": "(1.1) Improvised fact for this playthrough (3.1) / （1.1）このプレイの即興の設定（3.1）",
      "type": "object",
      "properties": {
        "factId": {
          "$ref": "common.schema.json#/$defs/RunFactId"
        },
        "character": {
          "$ref": "common.schema.json#/$defs/CharacterId",
          "description": "Who said it (whom it is attributed to) / 誰が言ったか（誰に帰属するか）"
        },
        "statement": {
          "type": "string",
          "description": "One neutral Japanese sentence / 中立的な日本語の一文"
        },
        "madeBy": {
          "$ref": "common.schema.json#/$defs/EventId",
          "description": "The event that recorded it / これを記録したイベント"
        }
      },
      "required": ["factId", "character", "statement", "madeBy"],
      "additionalProperties": false
    }
  }
}
