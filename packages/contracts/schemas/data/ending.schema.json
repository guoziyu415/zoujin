{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data/ending.schema.json",
  "description": "Data contract 1.5: Ending, CharacterEnding (section 5) / データ契約 1.5：Ending、CharacterEnding（第 5 節）",
  "$ref": "#/$defs/Ending",
  "$defs": {
    "Ending": {
      "title": "Ending",
      "description": "Ending (section 5). For endings written from 1.6 on, world.title, player.didForYou / youDid (may be empty arrays), characters and card are required / エンディング（第 5 節）。1.6 以降に書き込むエンディングでは world.title、player.didForYou / youDid（空配列でもよい）、characters、card が必須",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "$ref": "common.schema.json#/$defs/SchemaVersion"
        },
        "endingId": {
          "$ref": "common.schema.json#/$defs/EndingId"
        },
        "playthroughId": {
          "$ref": "common.schema.json#/$defs/PlaythroughId"
        },
        "worldModelVersion": {
          "type": "string"
        },
        "trigger": {
          "enum": ["deadline", "story-closed", "abandoned"],
          "description": "story-closed = the closing beat of the last act has an outcome / story-closed = 最後の幕の幕を閉じるビートに結果が出た"
        },
        "t": {
          "$ref": "common.schema.json#/$defs/StoryTime"
        },
        "decidedAt": {
          "$ref": "common.schema.json#/$defs/RecordedAt"
        },
        "world": {
          "type": "object",
          "properties": {
            "outcome": {
              "$ref": "common.schema.json#/$defs/WorldEndingId",
              "description": "WorldModel.endings.world[].id (baseline class) / WorldModel.endings.world[].id（基本類型）"
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "description": "Japanese / 日本語"
            },
            "changedBeats": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "beat": {
                    "$ref": "common.schema.json#/$defs/BeatId"
                  },
                  "to": {
                    "type": "string"
                  },
                  "causedBy": {
                    "type": "array",
                    "items": {
                      "$ref": "common.schema.json#/$defs/EventId"
                    }
                  }
                },
                "required": ["beat", "to", "causedBy"],
                "additionalProperties": false
              },
              "description": "Beats that differ from the original, each pointing back to events / 原作と異なるビート。それぞれイベントを指し示す"
            },
            "finalVars": {
              "type": "object",
              "propertyNames": {
                "$ref": "common.schema.json#/$defs/VarId"
              },
              "additionalProperties": {}
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "(1.1) A one-line title for the world ending. Required from 1.6: a playthrough with a template epilogue writes the label of this class from the world model's endings.world (world.title in api-contract 2.8) / （1.1）世界のエンディングの一行タイトル。1.6 以降は必須：テンプレートのエピローグを使うプレイでは、世界モデルの endings.world にあるこの類型の label を書く（api-contract 2.8 の world.title）"
            },
            "variant": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Unique within the playthrough, e.g. \"gen.king-abdicates\" (the API's outcomeId) / プレイ内で一意。例：\"gen.king-abdicates\"（API の outcomeId）"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "claims": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "var": {
                        "$ref": "common.schema.json#/$defs/VarId"
                      },
                      "value": {}
                    },
                    "required": ["var", "value"],
                    "additionalProperties": false
                  },
                  "description": "The final state it claims; must match finalVars / これが主張する最終状態。finalVars と一致しなければならない"
                },
                "causedBy": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/EventId"
                  },
                  "minItems": 2,
                  "description": "At least 2 events from this playthrough (\"it makes sense\") / このプレイのイベントを少なくとも 2 つ（「筋が通る」）"
                }
              },
              "required": ["id", "title", "summary", "claims", "causedBy"],
              "additionalProperties": false,
              "description": "(1.1, S-031 ①) The world ending generated for this playthrough; absent = the baseline class itself / （1.1、S-031 ①）このプレイで生成した世界のエンディング。ない = 基本類型そのもの"
            },
            "signature": {
              "type": "object",
              "propertyNames": {
                "anyOf": [
                  {
                    "$ref": "common.schema.json#/$defs/VarId"
                  },
                  {
                    "$ref": "common.schema.json#/$defs/BeatId"
                  }
                ]
              },
              "additionalProperties": {},
              "description": "(1.1) The signature computed from endings.signature (2.9.1): variable → final value, beat → whether it happened as in the original / （1.1）endings.signature から算出したシグネチャ（2.9.1）：変数 → 最終値、ビート → 原作どおりに起きたか"
            },
            "contrast": {
              "type": "object",
              "properties": {
                "original": {
                  "type": "string",
                  "minLength": 1
                },
                "yours": {
                  "type": "string",
                  "minLength": 1
                },
                "beat": {
                  "$ref": "common.schema.json#/$defs/BeatId"
                }
              },
              "required": ["original", "yours"],
              "additionalProperties": false,
              "description": "(1.1, S-026) 「原作では…／あなたの世界では…」 / （1.1、S-026）「原作では…／あなたの世界では…」"
            }
          },
          "required": ["outcome", "summary", "changedBeats", "finalVars"],
          "additionalProperties": false
        },
        "player": {
          "type": "object",
          "properties": {
            "fate": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "causedBy": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/EventId"
                  },
                  "minItems": 1
                }
              },
              "required": ["id", "label", "causedBy"],
              "additionalProperties": false,
              "description": "Advisor, hostage, companion, witness, executed… / 相談役、人質、同行者、目撃者、処刑された…"
            },
            "relationships": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "character": {
                    "$ref": "common.schema.json#/$defs/CharacterId"
                  },
                  "trust": {
                    "$ref": "memory.schema.json#/$defs/Relationship/properties/trust"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "line": {
                    "type": "string",
                    "minLength": 1
                  },
                  "memoryIds": {
                    "type": "array",
                    "items": {
                      "$ref": "common.schema.json#/$defs/MemoryId"
                    }
                  }
                },
                "required": ["character", "trust", "label", "memoryIds"],
                "additionalProperties": false
              }
            },
            "title": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "causedBy": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/EventId"
                  },
                  "minItems": 1
                }
              },
              "required": ["text", "causedBy"],
              "additionalProperties": false,
              "description": "E.g. 「王に信を説いた旅人」 / 例「王に信を説いた旅人」"
            },
            "epilogue": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sentence": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cites": {
                    "type": "array",
                    "items": {
                      "$ref": "common.schema.json#/$defs/EventId"
                    },
                    "minItems": 1,
                    "description": "Cites at least one event from this playthrough / このプレイのイベントを少なくとも 1 つ引用する"
                  }
                },
                "required": ["sentence", "cites"],
                "additionalProperties": false
              },
              "description": "Each sentence cites at least one event / 各文で少なくとも 1 つのイベントを引用する"
            },
            "lastScene": {
              "type": "object",
              "properties": {
                "place": {
                  "$ref": "common.schema.json#/$defs/PlaceId"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "present": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/CharacterId"
                  },
                  "description": "(1.1) Characters present in the ending staging (S-053) / （1.1）エンディングの演出に居合わせる登場人物（S-053）"
                }
              },
              "required": ["place", "description"],
              "additionalProperties": false
            },
            "didForYou": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sentence": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cites": {
                    "type": "array",
                    "items": {
                      "$ref": "common.schema.json#/$defs/EventId"
                    },
                    "minItems": 1,
                    "description": "Cites at least one event from this playthrough / このプレイのイベントを少なくとも 1 つ引用する"
                  }
                },
                "required": ["sentence", "cites"],
                "additionalProperties": false
              },
              "description": "(1.1, D-012) What characters did for you / （1.1、D-012）登場人物があなたのためにしたこと"
            },
            "youDid": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sentence": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cites": {
                    "type": "array",
                    "items": {
                      "$ref": "common.schema.json#/$defs/EventId"
                    },
                    "minItems": 1,
                    "description": "Cites at least one event from this playthrough / このプレイのイベントを少なくとも 1 つ引用する"
                  }
                },
                "required": ["sentence", "cites"],
                "additionalProperties": false
              },
              "description": "(1.1) What you did for characters / （1.1）あなたが登場人物のためにしたこと"
            }
          },
          "required": [
            "fate",
            "relationships",
            "title",
            "epilogue",
            "lastScene"
          ],
          "additionalProperties": false
        },
        "characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CharacterEnding"
          },
          "description": "(1.1, D-015, S-032) All 7 talkable characters are included / （1.1、D-015、S-032）会話できる 7 人の登場人物が全員含まれる"
        },
        "card": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 14,
              "description": "Title ≤ 14 characters / 称号は 14 字以内"
            },
            "subtitle": {
              "type": "string",
              "minLength": 1,
              "maxLength": 26,
              "description": "Where the world ends up ≤ 26 characters / 世界の行く末は 26 字以内"
            },
            "contrast": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48,
              "description": "「原作との違い」 ≤ 48 characters / 「原作との違い」は 48 字以内"
            },
            "characterLines": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "character": {
                    "$ref": "common.schema.json#/$defs/CharacterId"
                  },
                  "line": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40,
                    "description": "≤ 40 characters / 40 字以内"
                  }
                },
                "required": ["character", "line"],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 3,
              "description": "(1–3 characters from 1.6) The 1–3 most affected characters; when nobody is ranked, one line for Melos (the card is laid out for at most 3 lines) / （1.6 以降 1〜3 人）最も影響を受けた 1〜3 人。誰も順位に入らないときはメロスの一文（カードは最大 3 行でレイアウトする）"
            }
          },
          "required": ["title", "subtitle", "contrast", "characterLines"],
          "additionalProperties": false,
          "description": "(1.1, S-049, S-051) Ending card; the character limits are guaranteed here. Generated for every playthrough from 1.6: a generated ending takes the 1–3 characters with the highest rank, and when nobody is ranked puts one line for Melos (from his original); for a playthrough that failed validation twice and fell back to the template epilogue, the fields take the pre-written sentences of the matching set in ux-design 11.4 / （1.1、S-049、S-051）エンディングカード。字数はここで保証する。1.6 以降はすべてのプレイで生成する：生成されたエンディングでは rank が上位の 1〜3 人を取り、誰も順位に入らないときはメロスの一文を置く（彼の original による）。検証に 2 回失敗してテンプレートのエピローグに切り替えたプレイでは、ux-design 11.4 の該当する組の事前に書いた文をフィールドに使う"
        },
        "share": {
          "type": "object",
          "properties": {
            "cardImageRef": {
              "type": "string"
            },
            "videoRef": {
              "type": "string"
            },
            "branchTreeRef": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "description": "Storage reference of the generated artifact / 生成された成果物の保存先への参照"
        }
      },
      "required": [
        "schemaVersion",
        "endingId",
        "playthroughId",
        "worldModelVersion",
        "trigger",
        "t",
        "decidedAt",
        "world",
        "player"
      ],
      "if": {
        "properties": {
          "schemaVersion": {
            "not": {
              "enum": ["1.0", "1.1", "1.2", "1.3", "1.4", "1.5"]
            }
          }
        },
        "required": ["schemaVersion"]
      },
      "then": {
        "required": ["characters", "card"],
        "properties": {
          "world": {
            "required": ["title"]
          },
          "player": {
            "required": ["didForYou", "youDid"]
          }
        }
      },
      "additionalProperties": false
    },
    "CharacterEnding": {
      "title": "CharacterEnding",
      "description": "(1.1) The ending of each talkable character (section 5) / （1.1）会話できる各登場人物の結末（第 5 節）",
      "type": "object",
      "properties": {
        "character": {
          "$ref": "common.schema.json#/$defs/CharacterId"
        },
        "rank": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "How deeply affected, starting at 1; null when unchanged / 影響の深さ。1 から始まる。unchanged のときは null"
        },
        "unchanged": {
          "type": "boolean",
          "description": "The player did not interact with them and the world's changes did not reach them: only 「原作どおり」 is shown, no sentences are generated / プレイヤーが関わらず、世界の変化も及ばなかった：「原作どおり」だけを表示し、文は生成しない"
        },
        "original": {
          "type": "string",
          "minLength": 1,
          "description": "Their ending in the original, one sentence (in Japanese) / 原作での結末。一文（日本語）"
        },
        "yours": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sentence": {
                "type": "string",
                "minLength": 1
              },
              "cites": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/EventId"
                },
                "minItems": 1,
                "description": "Cites at least one event from this playthrough / このプレイのイベントを少なくとも 1 つ引用する"
              }
            },
            "required": ["sentence", "cites"],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 3,
          "description": "1–3 sentences, 「あなたの世界では」; omitted when unchanged / 1〜3 文、「あなたの世界では」。unchanged のときは省略"
        }
      },
      "required": ["character", "rank", "unchanged"],
      "additionalProperties": false
    }
  }
}
