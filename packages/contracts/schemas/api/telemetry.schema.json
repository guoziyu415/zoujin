{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/telemetry.schema.json",
  "title": "api/telemetry",
  "description": "Frontend telemetry (data-design 9.3; fields set by data engineering) / フロントエンドのテレメトリ（data-design 9.3。フィールドはデータエンジニアリングが決める）",
  "$defs": {
    "QualityLevel": {
      "description": "Graphics quality level (D-019) / 画質レベル（D-019）",
      "type": "string",
      "enum": ["L0", "L1", "L2", "L3"],
      "title": "QualityLevel"
    },
    "InputMode": {
      "type": "string",
      "enum": ["voice", "text"],
      "title": "InputMode"
    },
    "TelemetryCommon": {
      "description": "Common properties (data-design 9.3), only coarse-grained device information; sent once per batch and copied to every entry of the batch when the server stores it (decided in the C-1 review) / 共通プロパティ（data-design 9.3）。粗い粒度の端末情報だけを含む。バッチごとに 1 回送り、サーバーが保存するときにそのバッチの各項目へコピーする（C-1 レビューで決定）",
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceClass", "os", "browser", "appVersion"],
      "properties": {
        "deviceClass": {
          "description": "Screen size class: logical pixels plus DPR, e.g. ios-390x844@3 / 画面サイズの区分：論理ピクセルと DPR。例：ios-390x844@3",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "browser": {
          "description": "Includes the name of an in-app browser / アプリ内ブラウザの名前を含む",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "appVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "title": "TelemetryCommon"
    },
    "TelemetryAppOpen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "clientTs", "props"],
      "properties": {
        "name": {
          "const": "app_open"
        },
        "playthroughId": {
          "description": "Omitted when there is no playthrough / プレイがないときは省略",
          "$ref": "../data/common.schema.json#/$defs/PlaythroughId"
        },
        "clientTs": {
          "description": "Real time: the device clock, ISO 8601 UTC, ending in Z (data-design 9.3) / 実時間：端末の時計。ISO 8601 UTC で末尾は Z（data-design 9.3）",
          "$ref": "../data/common.schema.json#/$defs/RecordedAt"
        },
        "t": {
          "description": "Story time, if any / 物語時間（あれば）",
          "$ref": "../data/common.schema.json#/$defs/StoryTime"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entry", "inAppBrowser"],
          "properties": {
            "entry": {
              "type": "string",
              "enum": ["direct", "line", "other"]
            },
            "inAppBrowser": {
              "type": "boolean"
            }
          }
        }
      },
      "title": "TelemetryAppOpen"
    },
    "TelemetryMicPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "clientTs", "props"],
      "properties": {
        "name": {
          "const": "mic_permission"
        },
        "playthroughId": {
          "description": "Omitted when there is no playthrough / プレイがないときは省略",
