        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["to", "reason"],
          "properties": {
            "from": {
              "$ref": "#/$defs/QualityLevel"
            },
            "to": {
              "$ref": "#/$defs/QualityLevel"
            },
            "reason": {
              "type": "string",
              "enum": ["start", "down", "up", "lowPower", "locked"]
            },
            "probeGpuMs": {
              "description": "GPU time of one frame from the starting-tier self-test (ms), included when reason = start; rounded to 0.1 ms (to prevent device fingerprinting, data-design 9.3) / 開始時の段階の自己テストでの 1 フレームの GPU 所要時間（ms）。reason = start のときに含める。0.1 ms 単位に丸める（端末フィンガープリント防止、data-design 9.3）",
              "type": "number",
              "minimum": 0
            },
            "assetMbps": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "title": "TelemetryQualityChanged"
    },
