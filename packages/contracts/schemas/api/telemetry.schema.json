            },
            "fromTap": {
              "description": "From tapping 「はじめる」 to being able to walk (milliseconds) / 「はじめる」をタップしてから歩けるようになるまで（ミリ秒）",
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "title": "TelemetrySceneReady"
    },
    "TelemetryWebVitals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "clientTs", "props"],
      "properties": {
        "name": {
          "const": "web_vitals"
        },
        "playthroughId": {
          "description": "Omitted when there is no playthrough / プレイがないときは省略",
          "$ref": "../data/common.schema.json#/$defs/PlaythroughId"
        },
        "clientTs": {
          "description": "Real time: the device clock, ISO 8601 UTC, ending in Z (data-design 9.3) / 実時間：端末の時計。ISO 8601 UTC で末尾は Z（data-design 9.3）",
          "$ref": "../data/common.schema.json#/$defs/RecordedAt"
        },
        "t": {
          "description": "Story time, if any / 物語時間（あれば）",
          "$ref": "../data/common.schema.json#/$defs/StoryTime"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lcp": {
              "type": "number",
              "minimum": 0
            },
            "inp": {
              "type": "number",
              "minimum": 0
            },
            "cls": {
              "type": "number",
              "minimum": 0
            },
            "inpTarget": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "loafScript": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      },
      "title": "TelemetryWebVitals"
    },
    "TelemetryPerfSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "clientTs", "props"],
      "properties": {
        "name": {
          "const": "perf_sample"
        },
        "playthroughId": {
          "description": "Omitted when there is no playthrough / プレイがないときは省略",
          "$ref": "../data/common.schema.json#/$defs/PlaythroughId"
        },
        "clientTs": {
          "description": "Real time: the device clock, ISO 8601 UTC, ending in Z (data-design 9.3) / 実時間：端末の時計。ISO 8601 UTC で末尾は Z（data-design 9.3）",
          "$ref": "../data/common.schema.json#/$defs/RecordedAt"
        },
        "t": {
          "description": "Story time, if any / 物語時間（あれば）",
          "$ref": "../data/common.schema.json#/$defs/StoryTime"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frameTimeHistogram",
            "longTasks",
            "renderer",
            "qualityLevel",
            "assetTier",
            "dpr",
            "drawCalls",
            "lowPower"
          ],
          "properties": {
            "frameTimeHistogram": {
              "description": "A 10-second frame-time histogram with 9 fixed buckets, each a frame count (data-design 9.3). Bucket i counts frames with \"previous bucket's upper bound < frame time ≤ this bucket's upper bound\"; the upper bounds are 8.5, 12, 17, 20, 26, 34, 51, 101 ms in order, and the last bucket is > 101 ms. Every boundary sits slightly above an integer multiple of the refresh interval, so the same kind of dropped frame does not split across two buckets. The buckets are fixed so that histograms from different frontend versions can be added up; changing the boundaries requires a new field / 10 秒間のフレーム時間のヒストグラム。9 つの固定の区間で、各区間はフレーム数（data-design 9.3）。第 i 区間は「前の区間の上限 < フレーム時間 ≤ この区間の上限」のフレームを数える。上限は順に 8.5、12、17、20、26、34、51、101 ms で、最後の区間は > 101 ms。境界はすべてリフレッシュ間隔の整数倍の少し上に置くので、同じ種類のフレーム落ちが 2 つの区間に分かれることはない。区間を固定しているので、異なるバージョンのフロントエンドから送られたヒストグラムを足し合わせられる。境界を変えるときは別のフィールドを新設する",
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 9,
              "maxItems": 9
            },
            "longTasks": {
              "type": "integer",
              "minimum": 0
            },
            "jsHeapMb": {
              "type": "number",
              "minimum": 0
            },
            "renderer": {
              "type": "string",
              "enum": ["webgl", "webgpu"]
            },
            "qualityLevel": {
              "$ref": "#/$defs/QualityLevel"
            },
            "assetTier": {
              "type": "string",
              "enum": ["standard", "high"]
            },
            "dpr": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "drawCalls": {
              "type": "integer",
              "minimum": 0
            },
            "lowPower": {
              "type": "boolean"
            }
          }
        }
      },
      "title": "TelemetryPerfSample"
    },
    "TelemetryQualityChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "clientTs", "props"],
      "properties": {
        "name": {
          "const": "quality_changed"
        },
        "playthroughId": {
          "description": "Omitted when there is no playthrough / プレイがないときは省略",
          "$ref": "../data/common.schema.json#/$defs/PlaythroughId"
        },
        "clientTs": {
          "description": "Real time: the device clock, ISO 8601 UTC, ending in Z (data-design 9.3) / 実時間：端末の時計。ISO 8601 UTC で末尾は Z（data-design 9.3）",
          "$ref": "../data/common.schema.json#/$defs/RecordedAt"
        },
        "t": {
          "description": "Story time, if any / 物語時間（あれば）",
