          "properties": {
            "lcp": {
              "type": "number",
              "minimum": 0
            },
            "inp": {
              "type": "number",
              "minimum": 0
            },
            "cls": {
              "type": "number",
              "minimum": 0
            },
            "inpTarget": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "loafScript": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      },
      "title": "TelemetryWebVitals"
    },
    "TelemetryPerfSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "clientTs", "props"],
      "properties": {
        "name": {
          "const": "perf_sample"
        },
        "playthroughId": {
          "description": "没有局时省略",
          "$ref": "../data/common.schema.json#/$defs/PlaythroughId"
        },
        "clientTs": {
          "description": "真实时间：设备的钟，ISO 8601 UTC，以 Z 结尾（data-design 9.3）",
          "$ref": "../data/common.schema.json#/$defs/RecordedAt"
        },
        "t": {
          "description": "故事时间，有的话",
          "$ref": "../data/common.schema.json#/$defs/StoryTime"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frameTimeHistogram",
            "longTasks",
            "renderer",
            "qualityLevel",
            "assetTier",
            "dpr",
            "drawCalls",
            "lowPower"
          ],
          "properties": {
            "frameTimeHistogram": {
              "description": "10 秒的帧时间直方图，固定 9 格，每格是帧数（data-design 9.3）。第 i 格数「上一格上界 < 帧时间 ≤ 这一格上界」的帧，上界依次是 8.5、12、17、20、26、34、51、101 ms，最后一格是 > 101 ms。边界都放在刷新间隔整数倍稍上，同一种掉帧不会拆到两格。格子固定，不同版本前端发来的直方图才能相加；要换边界就另起一个字段",
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 9,
              "maxItems": 9
            },
            "longTasks": {
              "type": "integer",
              "minimum": 0
            },
            "jsHeapMb": {
              "type": "number",
              "minimum": 0
            },
            "renderer": {
              "type": "string",
              "enum": ["webgl", "webgpu"]
            },
            "qualityLevel": {
              "$ref": "#/$defs/QualityLevel"
            },
            "assetTier": {
              "type": "string",
              "enum": ["standard", "high"]
            },
            "dpr": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "drawCalls": {
              "type": "integer",
              "minimum": 0
            },
            "lowPower": {
              "type": "boolean"
            }
          }
        }
      },
      "title": "TelemetryPerfSample"
    },
    "TelemetryQualityChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "clientTs", "props"],
      "properties": {
        "name": {
          "const": "quality_changed"
        },
