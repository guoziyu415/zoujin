          "$ref": "../data/common.schema.json#/$defs/StoryTime"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["to", "reason"],
          "properties": {
            "from": {
              "$ref": "#/$defs/QualityLevel"
            },
            "to": {
              "$ref": "#/$defs/QualityLevel"
            },
            "reason": {
              "type": "string",
              "enum": ["start", "down", "up", "lowPower", "locked"]
            },
            "probeGpuMs": {
              "description": "起始档自测的一帧 GPU 耗时（ms），reason = start 时带；取到 0.1 ms（防设备指纹，data-design 9.3）",
              "type": "number",
              "minimum": 0
            },
            "assetMbps": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "title": "TelemetryQualityChanged"
    },
