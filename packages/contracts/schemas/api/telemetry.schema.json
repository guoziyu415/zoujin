          "additionalProperties": false,
          "required": ["sceneId", "loadMs"],
          "properties": {
            "sceneId": {
              "$ref": "../data/common.schema.json#/$defs/SceneId"
            },
            "loadMs": {
              "type": "integer",
              "minimum": 0
            },
            "fromTap": {
              "description": "点「はじめる」到能走（毫秒）",
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "title": "TelemetrySceneReady"
    },
    "TelemetryWebVitals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "clientTs", "props"],
      "properties": {
        "name": {
          "const": "web_vitals"
        },
        "playthroughId": {
          "description": "没有局时省略",
