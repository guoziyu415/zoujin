          "$ref": "../data/common.schema.json#/$defs/RecordedAt"
        },
        "t": {
          "description": "Story time, if any / 物語時間（あれば）",
          "$ref": "../data/common.schema.json#/$defs/StoryTime"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "afterPrimer"],
          "properties": {
            "result": {
              "type": "string",
              "enum": ["granted", "denied", "unavailable"]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "afterPrimer": {
              "type": "boolean"
            }
          }
        }
      },
      "title": "TelemetryMicPermission"
    },
    "TelemetryRoleSelected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "clientTs", "props"],
      "properties": {
        "name": {
          "const": "role_selected"
        },
