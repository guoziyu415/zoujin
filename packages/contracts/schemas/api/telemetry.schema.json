{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/telemetry.schema.json",
  "title": "api/telemetry",
  "description": "前端遥测（data-design 9.3，数据工程定字段）",
  "$defs": {
    "QualityLevel": {
      "description": "画质级（D-019）",
      "type": "string",
      "enum": ["L0", "L1", "L2", "L3"],
      "title": "QualityLevel"
    },
    "InputMode": {
      "type": "string",
      "enum": ["voice", "text"],
      "title": "InputMode"
    },
    "TelemetryCommon": {
      "description": "公共属性（data-design 9.3），只有粗粒度的设备信息；每批带一次，服务端入库时抄到这一批的每条（C-1 评审定）",
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceClass", "os", "browser", "appVersion"],
      "properties": {
        "deviceClass": {
          "description": "屏幕尺寸类：逻辑像素加 DPR，如 ios-390x844@3",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "browser": {
          "description": "含 App 内浏览器名",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "appVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "title": "TelemetryCommon"
    },
    "TelemetryAppOpen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "clientTs", "props"],
      "properties": {
        "name": {
          "const": "app_open"
        },
        "playthroughId": {
          "description": "没有局时省略",
          "$ref": "../data/common.schema.json#/$defs/PlaythroughId"
        },
        "clientTs": {
          "description": "真实时间：设备的钟，ISO 8601 UTC，以 Z 结尾（data-design 9.3）",
          "$ref": "../data/common.schema.json#/$defs/RecordedAt"
        },
        "t": {
          "description": "故事时间，有的话",
          "$ref": "../data/common.schema.json#/$defs/StoryTime"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entry", "inAppBrowser"],
          "properties": {
            "entry": {
              "type": "string",
              "enum": ["direct", "line", "other"]
            },
            "inAppBrowser": {
              "type": "boolean"
            }
          }
        }
      },
      "title": "TelemetryAppOpen"
    },
    "TelemetryMicPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "clientTs", "props"],
      "properties": {
        "name": {
          "const": "mic_permission"
        },
        "playthroughId": {
          "description": "没有局时省略",
          "$ref": "../data/common.schema.json#/$defs/PlaythroughId"
        },
        "clientTs": {
          "description": "真实时间：设备的钟，ISO 8601 UTC，以 Z 结尾（data-design 9.3）",
          "$ref": "../data/common.schema.json#/$defs/RecordedAt"
        },
        "t": {
          "description": "故事时间，有的话",
          "$ref": "../data/common.schema.json#/$defs/StoryTime"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "afterPrimer"],
          "properties": {
            "result": {
              "type": "string",
              "enum": ["granted", "denied", "unavailable"]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "afterPrimer": {
              "type": "boolean"
            }
          }
        }
      },
      "title": "TelemetryMicPermission"
    },
    "TelemetryRoleSelected": {
      "type": "object",
