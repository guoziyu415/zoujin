        "clientTs": {
          "description": "Real time: the device clock, ISO 8601 UTC, ending in Z (data-design 9.3) / 実時間：端末の時計。ISO 8601 UTC で末尾は Z（data-design 9.3）",
          "$ref": "../data/common.schema.json#/$defs/RecordedAt"
        },
        "t": {
          "description": "Story time, if any / 物語時間（あれば）",
          "$ref": "../data/common.schema.json#/$defs/StoryTime"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["roleId"],
          "properties": {
            "roleId": {
              "$ref": "../data/common.schema.json#/$defs/RoleId"
            }
          }
        }
      },
      "title": "TelemetryRoleSelected"
    },
    "TelemetrySceneReady": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "clientTs", "props"],
      "properties": {
        "name": {
          "const": "scene_ready"
        },
        "playthroughId": {
          "description": "Omitted when there is no playthrough / プレイがないときは省略",
          "$ref": "../data/common.schema.json#/$defs/PlaythroughId"
        },
        "clientTs": {
          "description": "Real time: the device clock, ISO 8601 UTC, ending in Z (data-design 9.3) / 実時間：端末の時計。ISO 8601 UTC で末尾は Z（data-design 9.3）",
          "$ref": "../data/common.schema.json#/$defs/RecordedAt"
        },
        "t": {
