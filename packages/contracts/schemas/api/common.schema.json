{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/common.schema.json",
  "title": "api/common",
  "description": "接口的公共类型（api-contract 第 0、2、3 节共用的形状）",
  "$defs": {
    "BookId": {
      "description": "书的 ID（manifest 路径里的 bookId），例 hashire-merosu",
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "BookId"
    },
    "DraftId": {
      "description": "待确认的举动（3.9），draft_ 加 ULID（大写 Crockford base32，第一位 0〜7，同数据契约的运行时 ID）",
      "type": "string",
      "minLength": 1,
      "pattern": "^draft_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "DraftId"
    },
    "RevealId": {
      "description": "关键时刻（3.4），rev_ 加 ULID（大写 Crockford base32，第一位 0〜7，同数据契约的运行时 ID）",
      "type": "string",
      "minLength": 1,
      "pattern": "^rev_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "RevealId"
    },
    "PlanOptionId": {
      "description": "幕末说出打算后的替代去处（3.11 alternative.optionId）：plan_ 加 ULID，和别的运行时 ID 一样（C-1 评审定）",
      "type": "string",
      "minLength": 1,
      "pattern": "^plan_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "PlanOptionId"
    },
    "ClientMsgId": {
      "description": "前端生成的动作 ID（第 0 节「幂等」），例 UUID",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "title": "ClientMsgId"
    },
    "ActionId": {
      "description": "快照里情境动作的 ID（2.3），例 act_help_old-man_cart；服务端生成，前端原样回传",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "title": "ActionId"
    },
    "InteractableId": {
      "description": "场景里可「調べる」的东西或场景出口（2.3），例 obj.market-stall",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "title": "InteractableId"
    },
    "Spot": {
      "description": "场景里的位置点（第 0 节），前端在 3D 场景里定义，例 fountain-east",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "title": "Spot"
    },
    "AssetPath": {
      "description": "同源的静态资源路径（第 0 节「来源」），以 / 开头，文件名带 hash",
      "type": "string",
      "minLength": 1,
      "pattern": "^/[^\\s?#]*$",
      "title": "AssetPath"
    },
    "ClientTurnSeq": {
      "description": "前端分配的 turnSeq（3.1）：每条连接从 1 起，最高位为 0",
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "title": "ClientTurnSeq"
    },
    "ServerTurnSeq": {
      "description": "服务端发起的轮次的 turnSeq（3.1）：最高位为 1，从 0x80000001 起",
      "type": "integer",
      "minimum": 2147483649,
      "maximum": 4294967295,
      "title": "ServerTurnSeq"
    },
    "TurnSeq": {
      "description": "二进制帧和 turn 消息里的 turnSeq：uint32，前端分配的或服务端分配的",
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295,
      "title": "TurnSeq"
    },
    "Seq": {
      "description": "一局里的事件序号（2.4）",
      "type": "integer",
      "minimum": 1,
      "title": "Seq"
    },
    "LastSeq": {
      "description": "前端已应用的最后一个序号；还没有事件时为 0",
      "type": "integer",
      "minimum": 0,
      "title": "LastSeq"
    },
    "Minutes": {
      "description": "故事分钟数",
      "type": "integer",
      "minimum": 0,
      "title": "Minutes"
    },
    "Speaker": {
      "description": "说话的人：玩家或人物",
      "anyOf": [
        {
          "const": "player"
        },
        {
          "$ref": "../data/common.schema.json#/$defs/CharacterId"
        }
      ],
      "title": "Speaker"
    },
    "Text200": {
      "description": "玩家输入的文字，≤ 200 字（3.2）",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "title": "Text200"
    },
    "Voice": {
      "description": "语音状态（2.3、第 4 节 welcome）",
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "degraded", "minutesLeftToday"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "degraded": {
          "type": "boolean"
        },
        "minutesLeftToday": {
          "$ref": "#/$defs/Minutes"
        }
      },
      "title": "Voice"
    },
    "SnapshotClock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "tLabel", "deadlineT"],
      "properties": {
        "t": {
          "$ref": "../data/common.schema.json#/$defs/StoryTime"
        },
        "tLabel": {
          "$ref": "../data/common.schema.json#/$defs/TLabel"
        },
        "deadlineT": {
          "$ref": "../data/common.schema.json#/$defs/StoryTime"
        }
      },
      "title": "SnapshotClock"
    },
    "ClockPatch": {
      "description": "commit.patch.clock（3.4）：t、tLabel 必填，deadlineT 可选（C-1 评审定）",
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "tLabel"],
      "properties": {
        "t": {
          "$ref": "../data/common.schema.json#/$defs/StoryTime"
        },
        "tLabel": {
          "$ref": "../data/common.schema.json#/$defs/TLabel"
        },
        "deadlineT": {
          "$ref": "../data/common.schema.json#/$defs/StoryTime"
        }
      },
      "title": "ClockPatch"
    },
    "Deadline": {
      "description": "期限（2.3）：玩家知道约定（契约 1.7 knows(player, fact.promise)）之前 shown = false、没有 line；之后一直 shown = true、带 line（S-077 ⑫，v1.0.3）",
      "type": "object",
      "additionalProperties": false,
      "required": ["shown"],
      "properties": {
        "shown": {
          "type": "boolean"
        },
        "line": {
          "description": "期限那一行，例「期限　三日目の日没／遅れれば、身代わりが死ぬ」",
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "shown": {
            "const": true
          }
        }
      },
      "then": {
        "required": ["line"]
      },
      "else": {
        "not": {
          "required": ["line"]
        }
      },
      "title": "Deadline"
    },
    "Forecast": {
      "description": "梅洛斯预计到达刑场的时刻（2.3）；玩家知道约定之前整个为 null（防剧透，条件和 Deadline.shown 一样）",
      "type": "object",
      "additionalProperties": false,
      "required": ["melosEtaT", "beforeDeadline"],
      "properties": {
        "melosEtaT": {
          "$ref": "../data/common.schema.json#/$defs/StoryTime"
        },
        "beforeDeadline": {
          "description": "false 时地图顶部写「このままでは、日没に間に合わない」",
          "type": "boolean"
        }
      },
      "title": "Forecast"
    },
    "PlayerPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roleId", "place", "spot"],
      "properties": {
        "roleId": {
          "$ref": "../data/common.schema.json#/$defs/RoleId"
        },
        "place": {
          "$ref": "../data/common.schema.json#/$defs/PlaceId"
        },
        "spot": {
          "$ref": "#/$defs/Spot"
        }
      },
      "title": "PlayerPosition"
    },
    "PlayerPositionPatch": {
      "description": "commit.patch.player（3.4）：只给变了的字段",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "place": {
          "$ref": "../data/common.schema.json#/$defs/PlaceId"
        },
        "spot": {
          "$ref": "#/$defs/Spot"
        }
      },
      "minProperties": 1,
      "title": "PlayerPositionPatch"
    },
    "PlaceAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "enabled"],
      "properties": {
        "id": {
          "$ref": "../data/common.schema.json#/$defs/PlaceId"
        },
        "enabled": {
          "description": "false 时前端提前把那条路挡住",
          "type": "boolean"
        },
        "reason": {
          "description": "进不去的理由，一句故事里的说明；只在 enabled = false 时给",
          "type": "string",
          "minLength": 1
        }
      },
      "title": "PlaceAccess"
    },
    "CharacterPresence": {
      "description": "当前场景在场的人物（2.3）；还没有关系的人物两个 relation 字段都省略。group 的人物（群众、警吏）不占位置点，没有 spot（v1.0.4）",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "place", "activity", "talkable"],
      "properties": {
        "id": {
          "$ref": "../data/common.schema.json#/$defs/CharacterId"
        },
        "place": {
          "$ref": "../data/common.schema.json#/$defs/PlaceId"
        },
        "spot": {
          "$ref": "#/$defs/Spot"
        },
        "activity": {
          "$ref": "../data/world-model.schema.json#/$defs/Activity"
        },
        "talkable": {
          "type": "boolean"
        },
        "group": {
          "description": "（v1.0.4）一群人（契约 1.7 的 Character.group）：不占位置点，没有 spot，前端按地点成群地放（契约 3.1）",
          "$ref": "../data/world-model.schema.json#/$defs/Character/properties/group"
        },
        "relationLabel": {
          "$ref": "../data/memory.schema.json#/$defs/Relationship/properties/label"
        },
        "relationLevel": {
          "$ref": "../data/memory.schema.json#/$defs/Relationship/properties/level"
        }
      },
      "dependentRequired": {
        "relationLabel": ["relationLevel"],
        "relationLevel": ["relationLabel"]
      },
      "title": "CharacterPresence",
      "if": {
        "required": ["group"]
      },
      "then": {
        "not": {
          "required": ["spot"]
        }
      },
      "else": {
        "required": ["spot"]
      }
    },
    "CharacterPresencePatch": {
      "description": "commit.patch.characters[]（3.4）：按 id 合并，只给变了的字段。人物进场（之前不在当前场景）时带完整的 CharacterPresence 字段；离场就是 place 变成不在当前场景里的地点",
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "$ref": "../data/common.schema.json#/$defs/CharacterId"
        },
        "place": {
          "$ref": "../data/common.schema.json#/$defs/PlaceId"
        },
        "spot": {
          "$ref": "#/$defs/Spot"
        },
        "activity": {
          "$ref": "../data/world-model.schema.json#/$defs/Activity"
        },
        "talkable": {
          "type": "boolean"
        },
        "relationLabel": {
          "$ref": "../data/memory.schema.json#/$defs/Relationship/properties/label"
        },
        "relationLevel": {
          "$ref": "../data/memory.schema.json#/$defs/Relationship/properties/level"
        }
      },
      "dependentRequired": {
        "relationLabel": ["relationLevel"],
        "relationLevel": ["relationLabel"]
      },
      "title": "CharacterPresencePatch"
    },
    "Interactable": {
      "description": "场景里可「調べる」的东西（2.3，estimatedMinutes 为 0）和场景出口（3.8）",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "spot",
        "label",
        "enabled",
        "estimatedMinutes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/InteractableId"
        },
        "kind": {
          "description": "examine = 調べる；go = 场景出口（3.8）",
          "type": "string",
          "enum": ["examine", "go"]
        },
        "spot": {
          "$ref": "#/$defs/Spot"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "estimatedMinutes": {
          "$ref": "#/$defs/Minutes"
        }
      },
      "title": "Interactable"
    },
    "SituationalAction": {
      "description": "此刻能做的情境动作（2.3、3.8）",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionId",
        "kind",
        "label",
        "estimatedMinutes",
        "melos",
        "melosMinutes",
        "melosInTime",
        "enabled"
      ],
      "properties": {
        "actionId": {
          "$ref": "#/$defs/ActionId"
        },
        "kind": {
          "$ref": "../data/world-model.schema.json#/$defs/Affordance/properties/kind"
        },
        "target": {
          "description": "对象人物；没有对象的动作（wait 这类，世界模型 Affordance.target 可选）省略，不给 null（C-1 评审定）",
          "$ref": "../data/common.schema.json#/$defs/CharacterId"
        },
        "label": {
          "$ref": "../data/world-model.schema.json#/$defs/Affordance/properties/label"
        },
        "estimatedMinutes": {
          "$ref": "#/$defs/Minutes"
        },
        "melos": {
          "description": "第四幕对梅洛斯的影响（S-036、S-038）；没有为 null",
          "anyOf": [
            {
              "$ref": "../data/world-model.schema.json#/$defs/Affordance/properties/melos"
            },
            {
              "type": "null"
            }
          ]
        },
        "melosMinutes": {
          "description": "没有 melos 的动作为 null",
          "anyOf": [
            {
              "description": "做了以后梅洛斯到刑场的时刻按本局此刻的排程变多少分钟：正数晚到、负数早到（S-066 ①）",
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "melosInTime": {
          "description": "没有 melos 的动作为 null",
          "anyOf": [
            {
              "description": "做了以后这一局还赶不赶得上日没",
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "melos": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "melosMinutes": {
            "type": "null"
          },
          "melosInTime": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "melosMinutes": {
            "type": "integer"
          },
          "melosInTime": {
            "type": "boolean"
          }
        }
      },
      "title": "SituationalAction"
    },
    "ActionsPatch": {
      "description": "commit.patch.actions（3.4）",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "add": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SituationalAction"
          }
        },
        "remove": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionId"
          }
        }
      },
      "minProperties": 1,
      "title": "ActionsPatch"
    },
    "InteractablesPatch": {
      "description": "commit.patch.interactables：可调查物和场景出口（3.8）的增减，形状同 actions。add 里的 id 已经有了就整条替换（例：enabled 变了）（C-1 评审加）",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "add": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Interactable"
          }
        },
        "remove": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InteractableId"
          }
        }
      },
      "minProperties": 1,
      "title": "InteractablesPatch"
    },
    "ConfirmOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionId", "label"],
      "properties": {
        "optionId": {
          "description": "例 yes、no",
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "title": "ConfirmOption"
    },
    "PendingConfirm": {
      "description": "续玩时还没回答的意图确认：confirm（3.9）的字段加剩余秒数 remainingSec（第 4 节「含剩余秒数」），timeoutSec 照样给（C-1 评审定）",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draftId",
        "character",
        "prompt",
        "options",
        "timeoutSec",
        "remainingSec"
      ],
      "properties": {
        "draftId": {
          "$ref": "#/$defs/DraftId"
        },
        "character": {
          "$ref": "../data/common.schema.json#/$defs/CharacterId"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConfirmOption"
          },
          "minItems": 2
        },
        "timeoutSec": {
          "type": "integer",
          "minimum": 1
        },
        "remainingSec": {
          "type": "integer",
          "minimum": 0
        }
      },
      "title": "PendingConfirm"
    },
    "PendingApproach": {
      "description": "续玩时正走过来的人物：和 approach（3.10）同形",
      "type": "object",
      "additionalProperties": false,
      "required": ["character", "kind"],
      "properties": {
        "character": {
          "$ref": "../data/common.schema.json#/$defs/CharacterId"
        },
        "kind": {
          "type": "string",
          "enum": ["request", "news"]
        }
      },
      "title": "PendingApproach"
    },
    "Pending": {
      "description": "续玩时还没处理完的东西（第 4 节）",
      "type": "object",
      "additionalProperties": false,
      "required": ["reveal", "confirm", "actEnd", "safetyPause", "approach"],
      "properties": {
        "reveal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reveal"
            },
            {
              "type": "null"
            }
          ]
        },
        "confirm": {
          "anyOf": [
            {
              "$ref": "#/$defs/PendingConfirm"
            },
            {
              "type": "null"
            }
          ]
        },
        "actEnd": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActEnd"
            },
            {
              "type": "null"
            }
          ]
        },
        "safetyPause": {
          "type": "boolean"
        },
        "approach": {
          "anyOf": [
            {
              "$ref": "#/$defs/PendingApproach"
            },
            {
              "type": "null"
            }
          ]
        },
        "arrival": {
          "description": "（v1.0.4）幕切换以后还没落地：这一幕的 arrival 带 opener、服务端还没收到 act_landed 时给，和 act_transition.arrival 同形；没有时省略（3.11、第 4 节）",
          "$ref": "#/$defs/Arrival"
        }
      },
      "title": "Pending"
    },
    "Snapshot": {
      "description": "当前场景的世界投影（2.3），≤ 10 KB",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playthroughId",
        "lastSeq",
        "status",
        "actId",
        "sceneId",
        "clock",
        "deadline",
        "forecast",
        "player",
        "places",
        "characters",
        "interactables",
        "actions",
        "pending",
        "voice"
      ],
      "properties": {
        "playthroughId": {
          "$ref": "../data/common.schema.json#/$defs/PlaythroughId"
        },
        "lastSeq": {
          "$ref": "#/$defs/LastSeq"
        },
        "status": {
          "$ref": "../data/playthrough.schema.json#/$defs/Playthrough/properties/status"
        },
        "actId": {
          "$ref": "../data/common.schema.json#/$defs/ActId"
        },
        "sceneId": {
          "$ref": "../data/common.schema.json#/$defs/SceneId"
        },
        "clock": {
          "$ref": "#/$defs/SnapshotClock"
        },
        "deadline": {
          "$ref": "#/$defs/Deadline"
        },
        "forecast": {
          "anyOf": [
            {
              "$ref": "#/$defs/Forecast"
            },
            {
              "type": "null"
            }
          ]
        },
        "player": {
          "$ref": "#/$defs/PlayerPosition"
        },
        "places": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlaceAccess"
          }
        },
        "characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CharacterPresence"
          }
        },
        "interactables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Interactable"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SituationalAction"
          }
        },
        "pending": {
          "$ref": "#/$defs/Pending"
        },
        "voice": {
          "$ref": "#/$defs/Voice"
        }
      },
      "title": "Snapshot"
    },
    "SnapshotPatch": {
      "description": "commit.patch（3.4）：快照字段的增量，按 id 合并。voice、status 不走 patch（C-1 评审定）",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clock": {
          "$ref": "#/$defs/ClockPatch"
        },
        "deadline": {
          "$ref": "#/$defs/Deadline"
        },
        "forecast": {
          "anyOf": [
