{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/rest/timeline.schema.json",
  "title": "GET /v1/playthroughs/{id}/timeline",
  "description": "Chain-reaction map (2.5) / 連鎖反応マップ（2.5）",
  "x-endpoint": {
    "method": "GET",
    "path": "/v1/playthroughs/{id}/timeline",
    "params": "../common.schema.json#/$defs/PlaythroughPathParams",
    "responses": {
      "200": "#/$defs/TimelineResponse"
    }
  },
  "$defs": {
    "TimelineEventItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "eventId",
        "t",
        "tLabel",
        "summary",
        "place",
        "style",
        "causedByPlayer",
        "forPlayer",
        "knownBy"
      ],
      "properties": {
        "kind": {
          "const": "event"
        },
        "eventId": {
          "$ref": "../../data/common.schema.json#/$defs/EventId"
        },
        "t": {
          "$ref": "../../data/common.schema.json#/$defs/StoryTime"
        },
        "tLabel": {
          "$ref": "../../data/common.schema.json#/$defs/TLabel"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "place": {
          "$ref": "../../data/common.schema.json#/$defs/PlaceId"
        },
        "style": {
          "type": "string",
          "enum": ["player", "caused", "character", "system"]
        },
        "causedByPlayer": {
          "type": "boolean"
        },
        "forPlayer": {
          "type": "boolean"
        },
        "knownBy": {
          "description": "Lists only characters the player has met / プレイヤーが会ったことのある登場人物だけを列挙する",
          "type": "array",
          "items": {
            "$ref": "../../data/common.schema.json#/$defs/CharacterId"
          }
        }
      },
      "title": "TimelineEventItem"
    },
    "TimelineBeatItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "beatId", "t", "tLabel", "known"],
      "properties": {
        "kind": {
          "const": "beat"
        },
        "beatId": {
          "$ref": "../../data/common.schema.json#/$defs/BeatId"
        },
        "t": {
          "$ref": "../../data/common.schema.json#/$defs/StoryTime"
        },
        "tLabel": {
          "$ref": "../../data/common.schema.json#/$defs/TLabel"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "description": "canon = happened in the data contract's WorldState.beats / canon = データ契約の WorldState.beats の happened",
          "type": "string",
          "enum": [
            "canon",
            "hastened",
            "delayed",
            "prevented",
            "altered",
            "pending"
          ]
        },
        "known": {
          "description": "false for beats not reached yet or not yet known to the player; only the time is given / まだ来ていない、またはプレイヤーがまだ知らないビートは false で、時刻だけを送る",
          "type": "boolean"
        },
        "place": {
          "description": "(v1.0.16) The world model's Beat.place, for the 「場所」 row in the map node details. Given only when known (api-contract 2.5) / （v1.0.16）世界モデルの Beat.place。地図のノード詳細の「場所」欄に使う。known のときだけ送る（api-contract 2.5）",
          "$ref": "../../data/common.schema.json#/$defs/PlaceId"
        },
        "cite": {
          "description": "(v1.0.14) Source in the original: the world model's Beat.cite (Cite from data contract section 0), for the 「原作」 row in the map node details. Given only when known; a quote containing spoiler terms (spoilers()) for facts the player does not know yet is left out; omitted when the world model has no source or all are filtered out (api-contract 2.5) / （v1.0.14）原作の出典：世界モデルの Beat.cite（データ契約第 0 節の Cite）。地図のノード詳細の「原作」欄に使う。known のときだけ送る。プレイヤーがまだ知らない事実のネタバレ語（spoilers()）を含む引用は出さない。世界モデルに出典がない、またはすべて除外されたときは省略（api-contract 2.5）",
          "type": "array",
          "items": {
            "$ref": "../../data/common.schema.json#/$defs/Cite"
          },
          "minItems": 1
        }
      },
      "if": {
        "properties": {
          "known": {
            "const": true
          }
        }
      },
      "then": {
        "required": ["title", "status"]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": ["title"]
            },
            {
              "required": ["status"]
            },
            {
              "required": ["cite"]
            },
            {
              "required": ["place"]
            }
          ]
        }
      },
      "title": "TimelineBeatItem"
    },
    "TimelineItem": {
      "oneOf": [
        {
          "$ref": "#/$defs/TimelineEventItem"
        },
        {
          "$ref": "#/$defs/TimelineBeatItem"
        }
      ],
      "title": "TimelineItem"
    },
    "TimelineResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days", "lastSeq"],
      "properties": {
        "days": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["day", "label", "items"],
            "properties": {
              "day": {
                "type": "integer",
                "minimum": 0
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/TimelineItem"
                }
              }
            }
          }
        },
        "lastSeq": {
          "$ref": "../common.schema.json#/$defs/LastSeq"
        }
      },
      "title": "TimelineResponse"
    }
  }
}
