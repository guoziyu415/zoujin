{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/rest/books.schema.json",
  "title": "GET /v1/books",
  "x-endpoint": {
    "method": "GET",
    "path": "/v1/books",
    "responses": {
      "200": "#/$defs/BooksResponse"
    }
  },
  "$defs": {
    "BookSummary": {
      "title": "BookSummary",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bookId",
        "worldModelVersion",
        "title",
        "author",
        "year",
        "description",
        "availability",
        "manifestUrl"
      ],
      "properties": {
        "bookId": {
          "$ref": "../common.schema.json#/$defs/BookId"
        },
        "worldModelVersion": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "enum": ["available", "unavailable"]
        },
        "manifestUrl": {
          "$ref": "../common.schema.json#/$defs/AssetPath"
        }
      },
      "description": "Lists only explicitly configured, finished books; a book is not opened automatically just because a world draft is found. availability is decided by loadable assets and open roles. / 明示的に設定された制作済みの本だけを列挙する。世界の草稿が見つかっただけで自動的に公開はしない。availability は読み込めるリソースと公開されている身分で決まる。"
    },
    "BooksResponse": {
      "title": "BooksResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["books"],
      "properties": {
        "books": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BookSummary"
          }
        }
      }
    }
  }
}
