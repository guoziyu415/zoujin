{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/rest/manifest.schema.json",
  "title": "GET /v1/books/{bookId}/manifest",
  "description": "Static content (2.1); the URL carries a version, cached long-term / 静的コンテンツ（2.1）。URL にバージョンを含み、長期間キャッシュする",
  "x-endpoint": {
    "method": "GET",
    "path": "/v1/books/{bookId}/manifest",
    "params": "#/$defs/ManifestParams",
    "responses": {
      "200": "#/$defs/ManifestResponse"
    },
    "query": "#/$defs/ManifestQuery"
  },
  "$defs": {
    "ManifestParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bookId"],
      "properties": {
        "bookId": {
          "$ref": "../common.schema.json#/$defs/BookId"
        }
      },
      "title": "ManifestParams"
    },
    "VoiceClip": {
      "description": "One pre-recorded line (2.1) / 事前収録セリフ 1 つ（2.1）",
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "text", "durationMs"],
      "properties": {
        "url": {
          "$ref": "../common.schema.json#/$defs/AssetPath"
        },
        "text": {
          "description": "The script text, used for the subtitles (source = script) / 台本の原文。字幕にこれを使う（source = script）",
          "type": "string",
          "minLength": 1
        },
        "durationMs": {
          "description": "Actual audio duration / 実際の音声の長さ",
          "type": "integer",
          "minimum": 1
        }
      },
      "title": "VoiceClip"
    },
    "Prerecorded": {
      "description": "The 6 lines of ux-design 16.2 plus fixed lines (2.1) / ux-design 16.2 の 6 つのセリフと固定セリフ（2.1）",
      "type": "object",
      "additionalProperties": false,
      "required": ["aizuchi", "unheard", "wait", "cues"],
      "properties": {
        "aizuchi": {
          "description": "3 aizuchi (backchannel) lines / 相槌 3 つ",
          "type": "array",
          "items": {
            "$ref": "#/$defs/VoiceClip"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "unheard": {
          "description": "2 lines for when the player could not be heard / 聞き取れなかったときのセリフ 2 つ",
          "type": "array",
          "items": {
            "$ref": "#/$defs/VoiceClip"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "wait": {
          "$ref": "#/$defs/VoiceClip"
        },
        "cues": {
          "description": "Fixed lines the server triggers at certain moments, keyed by commit.cue.kind; an empty object if there are none / サーバーがある時点で発する固定セリフ。キーは commit.cue.kind。なければ空のオブジェクト",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "arrival_capped": {
              "$ref": "#/$defs/VoiceClip"
            }
          }
        }
      },
      "title": "Prerecorded"
    },
    "SetPieceVoiceKey": {
      "description": "(v1.0.4) Key of manifest.setPieceVoices: 「{set piece ID}/{n}」, with n starting at 1, e.g. piece.gate-taken/2 / （v1.0.4）manifest.setPieceVoices のキー：「{固定演出 ID}/{番号}」。番号は 1 から始まる。例：piece.gate-taken/2",
      "type": "string",
      "pattern": "^piece\\.[a-z0-9]+(?:[.-][a-z0-9]+)*/[1-9][0-9]*$",
      "title": "SetPieceVoiceKey"
    },
    "ManifestResponse": {
      "description": "Content that does not change (2.1), generated at build time from the world model and the asset manifest / 変わらない内容（2.1）。ビルド時に世界モデルとリソース一覧から生成する",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestVersion",
        "book",
        "roles",
        "scenes",
        "places",
        "characters",
        "acts",
        "clock",
        "ruby"
      ],
      "properties": {
        "manifestVersion": {
          "type": "string",
          "minLength": 1
        },
        "book": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title", "author"],
          "properties": {
            "id": {
              "$ref": "../common.schema.json#/$defs/BookId"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "author": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "roleId",
              "name",
              "summary",
              "startSceneId",
              "startActId"
            ],
            "properties": {
              "roleId": {
                "$ref": "../../data/common.schema.json#/$defs/RoleId"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "startSceneId": {
                "$ref": "../../data/common.schema.json#/$defs/SceneId"
              },
              "startActId": {
                "$ref": "../../data/common.schema.json#/$defs/ActId"
              }
            }
          },
          "minItems": 1
        },
        "scenes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sceneId", "places", "assetUrl", "assetVersion"],
            "properties": {
              "sceneId": {
                "$ref": "../../data/common.schema.json#/$defs/SceneId"
              },
              "places": {
                "type": "array",
                "items": {
                  "$ref": "../../data/common.schema.json#/$defs/PlaceId"
                },
                "minItems": 1
              },
              "assetUrl": {
                "$ref": "../common.schema.json#/$defs/AssetPath"
              },
              "assetVersion": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1
        },
        "places": {
          "description": "(v1.0.14) All places of the world model and their names (Place.name), for showing place names in the map node details and anywhere other than the end-of-act subtitle. sceneId: the scene the place is in; null for places with no scene, or whose scene is not in scenes (no scene pack) / （v1.0.14）世界モデルのすべての地点とその名前（Place.name）。地図のノード詳細や、幕末の副題以外で地名を表示する場所に使う。sceneId：地点のあるシーン。シーンがない、またはシーンが scenes にない（シーンパックがない）地点は null",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["placeId", "name", "sceneId"],
            "properties": {
              "placeId": {
                "$ref": "../../data/common.schema.json#/$defs/PlaceId"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "sceneId": {
                "oneOf": [
                  {
                    "$ref": "../../data/common.schema.json#/$defs/SceneId"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "minItems": 1
        },
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "reading", "talkable"],
            "properties": {
              "id": {
                "$ref": "../../data/common.schema.json#/$defs/CharacterId"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "reading": {
                "type": "string",
                "minLength": 1
              },
              "talkable": {
                "type": "boolean"
              },
              "prerecorded": {
                "description": "Present only once the voice is decided (Q-004); characters who cannot talk have none / 声が決まってからある（Q-004）。会話できない登場人物にはない",
                "$ref": "#/$defs/Prerecorded"
              }
            }
          }
        },
        "acts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actId", "title", "sceneIds"],
            "properties": {
              "actId": {
                "$ref": "../../data/common.schema.json#/$defs/ActId"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "sceneIds": {
                "type": "array",
                "items": {
                  "$ref": "../../data/common.schema.json#/$defs/SceneId"
                },
                "minItems": 1
              }
            }
          }
        },
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deadlineT", "sunsetMinuteOfDay", "days"],
          "properties": {
            "deadlineT": {
              "$ref": "../../data/common.schema.json#/$defs/StoryTime"
            },
            "sunsetMinuteOfDay": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1439
            },
            "days": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        },
        "ruby": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["word", "reading"],
            "properties": {
              "word": {
                "type": "string",
                "minLength": 1
              },
              "reading": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "setPieceVoices": {
          "description": "(v1.0.4) Characters' pre-recorded lines in set pieces (2.1, 3.14). Key 「{set piece ID}/{n}」, where n = the position of this line in that set piece's lines (starting at 1, with 地の文 lines counted too). Generated at build time with this character's voice; characters who cannot talk (the officers) have them too; lines whose voice has not been generated yet have no key. Omitted when there are no set pieces / （v1.0.4）固定演出の中の登場人物の事前収録セリフ（2.1、3.14）。キーは「{固定演出 ID}/{番号}」で、番号 = その固定演出の lines の中でのこのセリフの位置（1 から始まり、地の文も数える）。ビルド時にその登場人物の声で生成する。会話できない登場人物（警吏）にもある。声がまだ生成されていないセリフにはキーがない。固定演出がなければ省略",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/SetPieceVoiceKey"
          },
          "additionalProperties": {
            "$ref": "#/$defs/VoiceClip"
          }
        }
      },
      "title": "ManifestResponse"
    },
    "ManifestQuery": {
      "title": "ManifestQuery",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worldModelVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "The locked world version for resuming an existing save; the current account must own a save of this book at this version. / 既存のセーブを再開するための固定された世界のバージョン。現在のアカウントがこの本のこのバージョンのセーブを持っている必要がある。"
        }
      }
    }
  }
}
