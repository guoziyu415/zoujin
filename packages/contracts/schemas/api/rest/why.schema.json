{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/rest/why.schema.json",
  "title": "GET /v1/playthroughs/{id}/why",
  "description": "「なぜこうなった？」（2.6）",
  "x-endpoint": {
    "method": "GET",
    "path": "/v1/playthroughs/{id}/why",
    "params": "../common.schema.json#/$defs/PlaythroughPathParams",
    "query": "#/$defs/WhyQuery",
    "responses": {
      "200": "#/$defs/WhyResponse"
    }
  },
  "$defs": {
    "WhyQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": {
          "description": "The ID of an event, beat or key moment, or forecast / イベント、ビート、重要な瞬間の ID、または forecast",
          "anyOf": [
            {
              "$ref": "../../data/common.schema.json#/$defs/EventId"
            },
            {
              "$ref": "../../data/common.schema.json#/$defs/BeatId"
            },
            {
              "$ref": "../common.schema.json#/$defs/RevealId"
            },
            {
              "const": "forecast"
            }
          ]
        }
      },
      "title": "WhyQuery"
    },
    "WhyResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "chain", "collapsed"],
      "properties": {
        "target": {
          "description": "Same as the target in the query / query の target と同じ",
          "anyOf": [
            {
              "$ref": "../../data/common.schema.json#/$defs/EventId"
            },
            {
              "$ref": "../../data/common.schema.json#/$defs/BeatId"
            },
            {
              "$ref": "../common.schema.json#/$defs/RevealId"
            },
            {
              "const": "forecast"
            }
          ]
        },
        "chain": {
          "description": "In chronological order, at most 12 steps / 時系列順、最大 12 段階",
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/WhyStep"
          },
          "maxItems": 12
        },
        "collapsed": {
          "description": "How many steps in the middle were collapsed / 途中で折りたたんだ段階の数",
          "type": "integer",
          "minimum": 0
        }
      },
      "title": "WhyResponse"
    }
  }
}
