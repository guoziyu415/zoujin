{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/rest/library.schema.json",
  "title": "GET /v1/library",
  "x-endpoint": {
    "method": "GET",
    "path": "/v1/library",
    "responses": {
      "200": "#/$defs/LibraryResponse"
    }
  },
  "$defs": {
    "LibraryActivePlaythrough": {
      "title": "LibraryActivePlaythrough",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playthroughId",
        "roleId",
        "roleName",
        "actId",
        "tLabel",
        "updatedAt",
        "bookId",
        "worldModelVersion"
      ],
      "properties": {
        "playthroughId": {
          "$ref": "../../data/common.schema.json#/$defs/PlaythroughId"
        },
        "roleId": {
          "$ref": "../../data/common.schema.json#/$defs/RoleId"
        },
        "roleName": {
          "type": "string",
          "minLength": 1
        },
        "actId": {
          "$ref": "../../data/common.schema.json#/$defs/ActId"
        },
        "tLabel": {
          "$ref": "../../data/common.schema.json#/$defs/TLabel"
        },
        "updatedAt": {
          "$ref": "../../data/common.schema.json#/$defs/RecordedAt"
        },
        "bookId": {
          "$ref": "../common.schema.json#/$defs/BookId"
        },
        "worldModelVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "The current account's single experience in progress, resumed with the book and world version locked for that playthrough. / 現在のアカウントで唯一の進行中の体験。そのプレイで固定された本と世界のバージョンで再開する。"
    },
    "LibraryPendingEnding": {
      "title": "LibraryPendingEnding",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playthroughId",
        "bookId",
        "worldModelVersion",
        "bookTitle",
        "roleId",
        "roleName",
        "endedAt"
      ],
      "properties": {
        "playthroughId": {
          "$ref": "../../data/common.schema.json#/$defs/PlaythroughId"
        },
        "bookId": {
          "$ref": "../common.schema.json#/$defs/BookId"
        },
        "worldModelVersion": {
          "type": "string",
          "minLength": 1
        },
        "bookTitle": {
          "type": "string",
          "minLength": 1
        },
        "roleId": {
          "$ref": "../../data/common.schema.json#/$defs/RoleId"
        },
        "roleName": {
          "type": "string",
          "minLength": 1
        },
        "endedAt": {
          "$ref": "../../data/common.schema.json#/$defs/RecordedAt"
        }
      },
      "description": "Finished, but the epilogue has not been stored yet; it must be shown as generating and must not be treated as a completed ending. / 終了したが、エピローグはまだ保存されていない。生成中として表示しなければならず、完了したエンディングとして扱ってはならない。"
    },
    "LibraryEnding": {
      "title": "LibraryEnding",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playthroughId",
        "bookId",
        "worldModelVersion",
        "bookTitle",
        "roleId",
        "roleName",
        "endedAt",
        "endingId",
        "title",
        "subtitle"
      ],
      "properties": {
        "playthroughId": {
          "$ref": "../../data/common.schema.json#/$defs/PlaythroughId"
        },
        "bookId": {
          "$ref": "../common.schema.json#/$defs/BookId"
        },
        "worldModelVersion": {
          "type": "string",
          "minLength": 1
        },
        "bookTitle": {
          "type": "string",
          "minLength": 1
        },
        "roleId": {
          "$ref": "../../data/common.schema.json#/$defs/RoleId"
        },
        "roleName": {
          "type": "string",
          "minLength": 1
        },
        "endedAt": {
          "$ref": "../../data/common.schema.json#/$defs/RecordedAt"
        },
        "endingId": {
          "$ref": "../../data/common.schema.json#/$defs/EndingId"
        },
        "title": {
          "$ref": "../../data/ending.schema.json#/$defs/Ending/properties/card/properties/title"
        },
        "subtitle": {
          "$ref": "../../data/ending.schema.json#/$defs/Ending/properties/card/properties/subtitle"
        }
      },
      "description": "Only from this account's endings with status=ended that have been stored; does not include endings not yet experienced, or internal causality and variables. / このアカウントの status=ended で保存済みの endings からのみ取る。未体験のエンディングや、内部の因果と変数は含まない。"
    },
    "LibraryResponse": {
      "title": "LibraryResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["activePlaythrough", "endings", "pendingEndings"],
      "properties": {
        "activePlaythrough": {
          "anyOf": [
            {
              "$ref": "#/$defs/LibraryActivePlaythrough"
            },
            {
              "type": "null"
            }
          ]
        },
        "endings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LibraryEnding"
          }
        },
        "pendingEndings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LibraryPendingEnding"
          }
        }
      }
    }
  }
}
