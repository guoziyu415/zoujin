{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api/rest/ending.schema.json",
  "title": "GET /v1/playthroughs/{id}/ending",
  "description": "Ending (2.8) / エンディング（2.8）",
  "x-endpoint": {
    "method": "GET",
    "path": "/v1/playthroughs/{id}/ending",
    "params": "../common.schema.json#/$defs/PlaythroughPathParams",
    "responses": {
      "200": "#/$defs/EndingView",
      "202": "#/$defs/EndingPending"
    }
  },
  "$defs": {
    "EndingPending": {
      "description": "Not generated yet (202) / まだ生成されていない（202）",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "etaSeconds"],
      "properties": {
        "status": {
          "const": "pending"
        },
        "etaSeconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "title": "EndingPending"
    },
    "EndingWorldView": {
      "description": "The world layer of the ending (2.8). contrast is optional, as in the data contract / エンディングの世界の層（2.8）。contrast はデータ契約と同じく任意",
      "type": "object",
      "additionalProperties": false,
      "required": ["outcomeId", "baseline", "title", "epilogue"],
      "properties": {
        "outcomeId": {
          "description": "variant?.id ?? outcome",
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "description": "true = one of the 5 baseline ending classes (no variant) / true = 5 つの基本類型のエンディングのいずれか（variant なし）",
          "type": "boolean"
        },
        "title": {
          "description": "variant?.title ?? title",
          "$ref": "../../data/ending.schema.json#/$defs/Ending/properties/world/properties/title"
        },
        "epilogue": {
          "$ref": "../../data/ending.schema.json#/$defs/Ending/properties/player/properties/epilogue"
        },
        "contrast": {
          "$ref": "../../data/ending.schema.json#/$defs/Ending/properties/world/properties/contrast"
        }
      },
      "title": "EndingWorldView"
    },
    "EndingYouView": {
      "description": "The \"you\" layer of the ending (2.8) / エンディングの「あなた」の層（2.8）",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "fate", "didForYou", "youDid"],
      "properties": {
        "title": {
          "$ref": "../../data/ending.schema.json#/$defs/Ending/properties/player/properties/title/properties/text"
        },
        "fate": {
          "$ref": "../../data/ending.schema.json#/$defs/Ending/properties/player/properties/fate/properties/label"
        },
        "didForYou": {
          "$ref": "../../data/ending.schema.json#/$defs/Ending/properties/player/properties/didForYou"
        },
        "youDid": {
          "$ref": "../../data/ending.schema.json#/$defs/Ending/properties/player/properties/youDid"
        }
      },
      "title": "EndingYouView"
    },
    "EndingCardView": {
      "description": "Ending card (2.8): Ending.card plus fallbackImageUrl / エンディングカード（2.8）：Ending.card に fallbackImageUrl を加えたもの",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subtitle",
        "characterLines",
        "contrast",
        "fallbackImageUrl"
      ],
      "properties": {
        "title": {
          "$ref": "../../data/ending.schema.json#/$defs/Ending/properties/card/properties/title"
        },
        "subtitle": {
          "$ref": "../../data/ending.schema.json#/$defs/Ending/properties/card/properties/subtitle"
        },
        "characterLines": {
          "$ref": "../../data/ending.schema.json#/$defs/Ending/properties/card/properties/characterLines"
        },
        "contrast": {
          "$ref": "../../data/ending.schema.json#/$defs/Ending/properties/card/properties/contrast"
        },
        "fallbackImageUrl": {
          "description": "Pre-drawn illustration used when the frame capture fails (one per baseline ending class) / フレームの取得に失敗したときに使う事前に描いたイラスト（基本類型のエンディングごとに 1 枚）",
          "$ref": "../common.schema.json#/$defs/AssetPath"
        }
      },
      "title": "EndingCardView"
    },
    "EndingView": {
      "description": "Ending (2.8): three layers, world → you → characters / エンディング（2.8）：world → you → characters の 3 層",
      "type": "object",
      "additionalProperties": false,
      "required": ["endingId", "world", "you", "characters", "card"],
      "properties": {
        "endingId": {
          "$ref": "../../data/ending.schema.json#/$defs/Ending/properties/endingId"
        },
        "world": {
          "$ref": "#/$defs/EndingWorldView"
        },
        "you": {
          "$ref": "#/$defs/EndingYouView"
        },
        "characters": {
          "$ref": "../../data/ending.schema.json#/$defs/Ending/properties/characters"
        },
        "card": {
          "description": "Present for every playthrough (S-076, data contract 1.6 section 5): a generated ending takes the 1–3 characters with the highest rank, and when nobody is ranked puts one line for Melos; a playthrough with a template epilogue uses the pre-written sentences of the matching set in ux-design 11.4 / すべてのプレイにある（S-076、データ契約 1.6 第 5 節）：生成されたエンディングでは rank が上位の 1〜3 人を取り、誰も順位に入らないときはメロスの一文を置く。テンプレートのエピローグを使うプレイでは ux-design 11.4 の該当する組の事前に書いた文を使う",
          "$ref": "#/$defs/EndingCardView"
        }
      },
      "title": "EndingView"
    }
  }
}
