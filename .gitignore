# 依赖和缓存
node_modules/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pnpm-store/
dist/
out/
# Playwright（apps/web 的 e2e 截图和报告）
test-results/
playwright-report/

# 本机设置和凭证（不要写 *.json：Schema 和 world.json 都是 .json）
.env*
*.key
*.pem
application_default_credentials.json
*credentials*.json
*sa-key*.json
service-account*.json
client_secret*.json

# 还没用过的留出样本只放项目文件夹（CONTRIBUTING「不进仓库的」），整个拷 evals/ 时挡住
evals/holdout/

# 系统文件
.DS_Store

# 场景生成物（F-2）：项目容器推不了 Git LFS（lfs.github.com 被网络策略挡），能推之前不进仓库，
# 用 assets/pipeline/plaza/build.sh 重新生成；清单 scene.json 进仓库
assets/scenes/*/build/
