, "relation": "様子を見ている", "unchanged": false}, {"character": "char.old-man", "forgotYou": false, "name": "市の老爺", "originalEnding": "あたりをはばかる低声で、王の暴虐をメロスに打ち明けた。", "rank": 6, "relation": "様子を見ている", "unchanged": false}], "events": [{"actor": "system", "beat": {"id": "beat.01", "to": "happened"}, "eventId": "e1", "summary": "メロスは未明に村を出て、十里の道を市へ向かう。", "t": 240, "type": "beat"}, {"actor": "system", "beat": {"id": "beat.02", "to": "happened"}, "eventId": "e2", "summary": "買い物を終え大路を歩くうち、日が落ちた市がやけに寂しいことに気づく。", "t": 1150, "type": "beat"}, {"actor": "system", "beat": {"id": "beat.03", "to": "happened"}, "eventId": "e3", "summary": "若い衆は答えず、老爺をゆすぶって問うと、王が人を信じられず次々に殺していると聞く。メロスは激怒する。", "t": 1170, "type": "beat"}, {"actor": "system", "beat": {"id": "beat.04", "to": "happened"}, "eventId": "e4", "summary": "買い物を背負ったまま王城へ入って行き、門の前庭で巡邏の警吏に捕らえられる。懐から短剣が出る。王城の中へ引かれてゆく。", "t": 1200, "type": "beat"}, {"actor": "system", "beat": {"id": "beat.05", "to": "happened"}, "eventId": "e5", "summary": "メロスは王と言い争い、妹の婚礼のため三日の日限を乞い、セリヌンティウスを人質に差し出す。王は承諾し、遅れて来いとささやく。", "t": 1230, "type": "beat"}, {"actor": "system", "beat": {"id": "beat.06", "to": "happened"}, "eventId": "e6", "summary": "セリヌンティウスが深夜王城に召され、事情を聞いて無言でうなずき、メロスを抱きしめて縄を打たれる。", "t": 1410, "type": "beat"}, {"actor": "system", "beat": {"id": "beat.07", "to": "happened"}, "eventId": "e7", "summary": "メロスはすぐに出発し、一睡もせず十里の道を村へ急ぐ。", "t": 1425, "type": "beat"}, {"actor": "system", "eventId": "e8", "summary": "测试造的：梅洛斯没有放出来，beat.24 到不了，日没时期限结算", "t": 1425, "type": "action"}, {"actor": "player", "eventId": "e9", "summary": "旅人は、市に残り、メロスの帰りを待つことにした", "t": 1425, "type": "act-transition"}, {"actor": "system", "beat": {"id": "beat.09", "to": "happened"}, "eventId": "e10", "summary": "祭壇を飾り宴席を調えると、床に倒れ、夜まで深く眠る。", "t": 2070, "type": "beat"}, {"actor": "system", "beat": {"id": "beat.08", "to": "prevented"}, "eventId": "e11", "summary": "翌日の午前、疲れ果てて村に着き、羊の番をしていた妹に、あす婚礼を挙げると告げる。理由は話さない。", "t": 2280, "type": "beat"}, {"actor": "system", "beat": {"id": "beat.10", "to": "prevented"}, "eventId": "e12", "summary": "夜に目覚めて花婿の家を訪ね、葡萄の季節まで待ちたいという花婿を夜明けまでかけて説き伏せる。", "t": 3360, "type": "beat"}, {"actor": "system", "beat": {"id": "beat.12", "to": "happened"}, "eventId": "e13", "summary": "宣誓のころ黒雲が空を覆い、車軸を流すような大雨になる。雨は翌朝まで続く。", "t": 3630, "type": "beat"}, {"actor": "system", "beat": {"id": "beat.11", "to": "prevented"}, "eventId": "e14", "summary": "婚礼が真昼に行われる。", "t": 4000, "type": "beat"}, {"actor": "system", "beat": {"id": "beat.13", "to": "prevented"}, "eventId": "e15", "summary": "祝宴は夜に入って華やぎ、メロスは一生ここにいたいと願うが出発を決意し、妹と花婿に言葉を残す。", "t": 4300, "type": "beat"}, {"actor": "system", "beat": {"id": "beat.17", "to": "happened"}, "eventId": "e16", "summary": "前日の豪雨で水源地が氾濫し、橋は流され、繋ぎ舟もない。", "t": 4680, "type": "beat"}, {"actor": "system", "beat": {"id": "beat.15", "to": "happened"}, "eventId": "e17", "summary": "朝のうちに雨が止み、日が高く昇って暑くなる。", "t": 4860, "type": "beat"}, {"actor": "system", "beat": {"id": "beat.16", "to": "happened"}, "eventId": "e18", "summary": "隣村を過ぎ、故郷への未練を断ったメロスは、急ぐ必要もないと小歌を歌いながらぶらぶら歩く。", "t": 4900, "type": "beat"}, {"actor": "system", "beat": {"id": "beat.14", "to": "prevented"}, "eventId": "e19", "summary": "羊小屋で眠り、翌る日の薄明に跳ね起きて、雨の中を走り出る。", "t": 4900, "type": "beat"}, {"actor": "system", "beat": {"id": "beat.18", "to": "happened"}, "eventId": "e20", "summary": "真昼、川岸でゼウスに祈ったのち、激流に飛び込み、押し流されながらも対岸の木にすがりつく。", "t": 5040, "type": "beat"}, {"actor": "system", "beat": {"id": "beat.19", "to": "happened"}, "eventId": "e21", "summary": "峠をのぼり切ったところで山賊が躍り出る。メロスは棍棒を奪って三人を殴り倒し、峠を駈け降りる。", "t": 5160, "type": "beat"}, {"actor": "system", "beat": {"id": "beat.20", "to": "happened"}, "eventId": "e22", "summary": "午後の灼熱の中でついに膝を折り、悪徳者として生き延びようかとまで思い、まどろむ。", "t": 5220, "type": "beat"}, {"actor": "system", "beat": {"id": "beat.s2", "to": "happened"}, "eventId": "e23", "summary": "三日目の午後、日が傾いてもメロスは戻らない。城で縄を打たれたセリヌンティウスは、生れてはじめて、ちらと友を疑う。", "t": 5280, "type": "beat"}, {"actor": "system", "beat": {"id": "beat.21", "to": "happened"}, "eventId": "e24", "summary": "水の音に気づき、岩の裂目から湧く清水を一口飲んで甦る。「走れ！メロス」。", "t": 5310, "type": "beat"}, {"actor": "system", "beat": {"id": "beat.22", "to": "happened"}, "eventId": "e25", "summary": "人を押しのけ、酒宴を駈け抜け、ほとんど裸で血を吐きながら走る。すれちがった旅の一団の噂話を耳にする。", "t": 5370, "type": "beat"}, {"actor": "system", "eventId": "e26", "summary": "三日目へ", "t": 5370, "type": "act-transition"}, {"actor": "system", "beat": {"id": "beat.s1", "to": "happened"}, "eventId": "e27", "summary": "セリヌンティウスは刑場に引き出され、王にからかわれても「メロスは来ます」とだけ答える。", "t": 5400, "type": "beat"}, {"actor": "system", "beat": {"id": "beat.23", "to": "happened"}, "eventId": "e28", "summary": "市の近くでフィロストラトスが追いすがり、もう間に合わない、走るのをやめてと訴える。メロスは信じられているから走ると答える。", "t": 5430, "type": "beat"}, {"actor": "system", "eventId": "e29", "summary": "三日目の日没の刻限が来た", "t": 5460, "type": "action"}, {"actor": "system", "beat": {"id": "beat.24", "to": "prevented"}, "eventId": "e30", "summary": "陽が沈み切る寸前、メロスは刑場に突入し、釣り上げられてゆく友の両足にかじりつく。群衆がどよめき、縄がほどかれる。", "t": 5460, "type": "beat"}], "executed": true, "finalVars": {"var.act.current": "act.4", "var.bandits": "defeated", "var.bridge": "destroyed", "var.groom.agreed": false, "var.hostage.fate": "executed", "var.hostage.who": "char.selinuntius", "var.king.disposition": "tyrant", "var.king.trust": 5, "var.melos.clothing": "nearly-naked", "var.melos.custody": "free", "var.melos.doubted": true, "var.melos.knowsTyranny": true, "var.melos.location": "place.syracuse-square", "var.melos.resolve": 100, "var.melos.stamina": 30, "var.player.companionOf": "none", "var.player.custody": "free", "var.player.knowsShortcut": false, "var.player.location": "place.execution-ground", "var.player.walkedOldManHome": false, "var.promise.made": true, "var.river.crossing": "swam", "var.selinuntius.attended": false, "var.selinuntius.doubted": true, "var.selinuntius.faith": 0, "var.weather": "after-rain", "var.wedding.status": "planned"}, "forbidden": ["処刑", "死", "殺", "最期", "亡くな", "命を落と", "息絶え", "絶命", "事切れ", "帰らぬ人", "磔にされ", "磔になっ"], "improv": [], "memories":