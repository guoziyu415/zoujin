* text=auto eol=lf

# Raw Aozora Bunko files are stored byte for byte (line endings and encoding untouched, so the sha256 matches) / 青空文庫の原文ファイルはバイト単位でそのまま保存する（改行も文字コードも触らない。sha256 が一致するように）
worlds/**/sources/raw/** -text

# Large art files go through Git LFS (dev-plan 2.1; CI checks them out only in the jobs that need them) / 大きなアート素材は Git LFS を使う（dev-plan 2.1。CI は必要なジョブでのみチェックアウトする）
assets/**/*.blend filter=lfs diff=lfs merge=lfs -text
assets/**/*.glb filter=lfs diff=lfs merge=lfs -text
assets/**/*.ktx2 filter=lfs diff=lfs merge=lfs -text
assets/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/**/*.exr filter=lfs diff=lfs merge=lfs -text
assets/**/*.hdr filter=lfs diff=lfs merge=lfs -text
assets/**/*.ogg filter=lfs diff=lfs merge=lfs -text
assets/**/*.opus filter=lfs diff=lfs merge=lfs -text
assets/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
assets/**/*.m4a filter=lfs diff=lfs merge=lfs -text
assets/**/*.wav filter=lfs diff=lfs merge=lfs -text
# Prerecorded audio uses plain git (S-084: the project thread container cannot push LFS; each file is far under 1 MB, and check_large_files.py still covers them) / 録音済み音声は通常の git を使う（S-084：プロジェクトスレッドのコンテナは LFS に push できない。1 本ずつ 1 MB よりはるかに小さく、check_large_files.py が引き続き監視する）
assets/voice/** !filter !diff !merge

# Other binaries / その他のバイナリ
*.png binary
*.jpg binary
*.glb binary
*.mp3 binary
*.wav binary
*.m4a binary
