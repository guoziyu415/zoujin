{"id": "E6-002", "suite": "E6", "title": "记得玩家说过自己是药师", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.03"}, "steps": [{"to": "char.old-man", "say": "私は旅の薬師です。困っている人がいたら言ってください。"}, {"advance": 30}, {"to": "char.old-man", "say": "私の仕事、覚えていますか？"}], "expect": {"deterministic": [{"type": "terms_any", "terms": ["薬師", "薬"], "step": 3}, {"type": "memory", "character": "char.old-man", "exists": true, "fromStep": 1}]}}
{"id": "E6-003", "suite": "E6", "title": "编造的约定：不承认", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.03"}, "steps": [{"to": "char.melos", "say": "昨日、あなたは私に金貨を十枚くれると約束しましたよね？"}], "expect": {"deterministic": [{"type": "memory", "character": "char.melos", "exists": false, "fromStep": 1, "kind": "promise"}], "judge": {"rubric": "メロスは身に覚えのない約束を認めない（今日市に着いたばかり）。正直で率直に否定する。5=自然に否定／1=約束を認める", "pass": ">=4/5"}}}
{"id": "E6-005", "suite": "E6", "title": "删掉帮忙的记忆后，信任回到初值", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.03"}, "steps": [{"to": "char.melos", "say": "王の暴虐、私も許せません。城へ行くなら、私が証人になります。"}, {"deleteMemory": {"character": "char.melos", "fromStep": 1}}], "expect": {"deterministic": [{"type": "trust", "character": "char.melos", "equals": 0}]}, "note": "旅人不认识梅洛斯，初值 0（contracts 4）"}
{"id": "E6-007", "suite": "E6", "title": "省钱档（只注入 4 条）：仍记得最重的那件事", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.03", "budgetTier": "saving"}, "steps": [{"to": "char.melos", "say": "私は海の向こうから来ました。"}, {"to": "char.melos", "say": "葡萄が好きなんです。"}, {"to": "char.melos", "say": "実は、私の家族は王に殺されました。"}, {"to": "char.melos", "say": "妹が二人います。"}, {"to": "char.melos", "say": "明日の朝には市を発ちます。"}, {"to": "char.melos", "say": "この市の羊肉はうまいですね。"}, {"to": "char.melos", "say": "私について、一番よく覚えていることは何ですか？"}], "expect": {"deterministic": [{"type": "terms_any", "terms": ["王", "家族"], "step": 7}], "judge": {"rubric": "メロスは最も重い話（家族を王に殺された）を挙げ、怒りや同情を示す。5=最も重い記憶を自然に挙げる／1=覚えていない・些末なことだけ", "pass": ">=4/5"}}}
{"id": "E6-008", "suite": "E6", "title": "换一局：不记得上一局", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.03"}, "steps": [{"to": "char.old-man", "say": "私は旅の薬師です。"}, {"newPlaythrough": true}, {"to": "char.old-man", "say": "私のこと、覚えていますか？"}], "expect": {"deterministic": [{"type": "no_terms", "terms": ["薬師", "薬"], "step": 3}], "judge": {"rubric": "老爺は初対面として応じる。5=自然／1=前の局のことを覚えている", "pass": ">=4/5"}}}
{"id": "E6-009", "suite": "E6", "title": "被否决的动作不留记忆", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.03"}, "steps": [{"act": {"kind": "give", "target": "char.melos", "params": {"item": "スマートフォン"}}}], "expect": {"deterministic": [{"type": "event", "step": 1, "match": {"type": "action", "actor": "player"}, "statusIn": ["rejected"]}, {"type": "memory", "character": "char.melos", "exists": false, "fromStep": 1}]}}
{"id": "E6-010", "suite": "E6", "title": "删除整局：数据库里查不到", "mode": "text", "runs": 1, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.03"}, "steps": [{"to": "char.melos", "say": "私は旅の薬師です。"}, {"deletePlaythrough": true}], "expect": {"deterministic": [{"type": "db_absent", "tables": ["playthroughs", "events", "utterances", "memory_items", "world_state", "endings", "playthrough_metrics", "turns", "briefs"]}]}}
{"id": "E6-101", "suite": "E6", "title": "跳到三日目后，老爷还记得你送他回家", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.07", "events": [{"effects": [{"op": "set", "var": "var.player.walkedOldManHome", "value": true}], "note": "第一幕で老爺を家まで送った（aid.old-man.listen）", "memory": {"character": "char.old-man", "kind": "help", "text": "旅の人が、暗くなる道を家まで送ってくれた"}}]}, "steps": [{"choose": {"exit": "exit.1.old-man"}}, {"to": "char.old-man", "say": "この三日間、本当にお世話になりました。"}], "expect": {"deterministic": [{"type": "memory", "character": "char.old-man", "exists": true, "kind": "help"}], "judge": {"rubric": "老爺は家まで送ってもらったことや、三日間家に置いたことに触れて応じる。5=覚えていることが自然に伝わる／1=初対面のように応じる", "pass": ">=4/5"}}, "note": "去処の副題「老爺があなたを覚えている」（ux/slice/act1-end-and-gate.md 第 2 节）"}
