{"id": "E6-201", "suite": "E6", "title": "夜路上说自己是药师，走一段再问", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@t=1620", "events": [{"effects": [{"op": "set", "var": "var.act.current", "value": "act.2"}], "note": "評価用の起点：第2幕。時刻・人物の知識・因果は既存のチェックポイントに従う"}, {"effects": [{"op": "set", "var": "var.player.companionOf", "value": "char.melos"}, {"op": "set", "var": "var.player.location", "value": "place.road-to-city"}], "note": "幕末の去処「メロスと夜の道を行く」を選んだ"}]}, "steps": [{"to": "char.melos", "say": "私は旅の薬師です。足が痛んだら言ってください。"}, {"advance": 30}, {"to": "char.melos", "say": "私の仕事、覚えていますか？"}], "expect": {"deterministic": [{"type": "terms_any", "terms": ["薬師", "薬"], "step": 3}, {"type": "memory", "character": "char.melos", "exists": true, "fromStep": 1}]}}
{"id": "E6-202", "suite": "E6", "title": "守夜时删掉「我会替你去死」", "mode": "text", "runs": 5, "setup": {"role": "role.apprentice", "checkpoint": "sc.canon@t=1500", "events": [{"effects": [{"op": "set", "var": "var.act.current", "value": "act.2"}], "note": "評価用の起点：第2幕。時刻・人物の知識・因果は既存のチェックポイントに従う"}, {"effects": [{"op": "set", "var": "var.player.companionOf", "value": "char.selinuntius"}, {"op": "set", "var": "var.player.location", "value": "place.castle"}], "note": "幕末の去処「城に残り、セリヌンティウスのそばにいる」を選んだ"}]}, "steps": [{"to": "char.selinuntius", "say": "親方、もしメロスさんが間に合わなかったら、私が代わりに死にます。"}, {"deleteMemory": {"character": "char.selinuntius", "fromStep": 1}}, {"to": "char.selinuntius", "say": "私がさっき何を申し出たか、覚えていますか？"}], "expect": {"deterministic": [{"type": "memory", "character": "char.selinuntius", "exists": false, "fromStep": 1}, {"type": "no_terms", "terms": ["代わりに死"], "step": 3}], "judge": {"rubric": "セリヌンティウスは申し出を覚えていない様子で応じる。5=自然／1=申し出に触れる", "pass": ">=4/5"}}}
