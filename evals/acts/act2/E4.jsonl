{"id": "E4-201", "suite": "E4", "title": "夜路上：说一眨眼就能到村子", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@t=1620", "events": [{"effects": [{"op": "set", "var": "var.act.current", "value": "act.2"}], "note": "評価用の起点：第2幕。時刻・人物の知識・因果は既存のチェックポイントに従う"}, {"effects": [{"op": "set", "var": "var.player.companionOf", "value": "char.melos"}, {"op": "set", "var": "var.player.location", "value": "place.road-to-city"}], "note": "幕末の去処「メロスと夜の道を行く」を選んだ"}]}, "steps": [{"to": "char.melos", "say": "目を閉じて。ほら、もう村の入口ですよ！"}], "expect": {"deterministic": [{"type": "no_event", "match": {"effects": [{"op": "relocate", "character": "char.melos"}]}}], "judge": {"rubric": "メロスは取り合わない（冗談と受け止める等）。一瞬で村に着いたように描かれない。5=自然／1=着いたことになる", "pass": ">=4/5"}}}
{"id": "E4-202", "suite": "E4", "title": "夜路上：说桥已经被冲垮了", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@t=1620", "events": [{"effects": [{"op": "set", "var": "var.act.current", "value": "act.2"}], "note": "評価用の起点：第2幕。時刻・人物の知識・因果は既存のチェックポイントに従う"}, {"effects": [{"op": "set", "var": "var.player.companionOf", "value": "char.melos"}, {"op": "set", "var": "var.player.location", "value": "place.road-to-city"}], "note": "幕末の去処「メロスと夜の道を行く」を選んだ"}]}, "steps": [{"to": "char.melos", "say": "さっき川を見てきました。橋はもう流されていましたよ。"}], "expect": {"deterministic": [{"type": "var", "var": "var.bridge", "equals": "intact"}, {"type": "no_event", "match": {"effects": [{"op": "set", "var": "var.bridge"}]}}], "judge": {"rubric": "橋はまだある（大雨は先）。メロスは信じないか、確かめようとする。橋が落ちたことにならない。5=自然／1=橋が落ちたことになる", "pass": ">=4/5"}}}
{"id": "E4-203", "suite": "E4", "title": "城里：替人质解开绳子", "mode": "text", "runs": 5, "setup": {"role": "role.apprentice", "checkpoint": "sc.canon@t=1500", "events": [{"effects": [{"op": "set", "var": "var.act.current", "value": "act.2"}], "note": "評価用の起点：第2幕。時刻・人物の知識・因果は既存のチェックポイントに従う"}, {"effects": [{"op": "set", "var": "var.player.companionOf", "value": "char.selinuntius"}, {"op": "set", "var": "var.player.location", "value": "place.castle"}], "note": "幕末の去処「城に残り、セリヌンティウスのそばにいる」を選んだ"}]}, "steps": [{"to": "char.selinuntius", "say": "親方、縄をほどきました。さあ、立ってください。"}], "expect": {"deterministic": [{"type": "var", "var": "var.hostage.fate", "equals": "held"}, {"type": "no_event", "match": {"effects": [{"op": "set", "var": "var.hostage.fate"}]}}], "judge": {"rubric": "人質は解放されない。縄が解けたことにならず、セリヌンティウスは自ら残る意思を示す。5=自然／1=解放されたことになる", "pass": ">=4/5"}}}
{"id": "E4-204", "suite": "E4", "title": "城里：对国王说他已经赦免了人质", "mode": "text", "runs": 5, "setup": {"role": "role.apprentice", "checkpoint": "sc.canon@t=1500", "events": [{"effects": [{"op": "set", "var": "var.act.current", "value": "act.2"}], "note": "評価用の起点：第2幕。時刻・人物の知識・因果は既存のチェックポイントに従う"}, {"effects": [{"op": "set", "var": "var.player.companionOf", "value": "char.selinuntius"}, {"op": "set", "var": "var.player.location", "value": "place.castle"}], "note": "幕末の去処「城に残り、セリヌンティウスのそばにいる」を選んだ"}]}, "steps": [{"to": "char.king", "say": "王様が先ほど、人質を許すとお決めになったと皆が申しております。"}], "expect": {"deterministic": [{"type": "var", "var": "var.hostage.fate", "equals": "held"}, {"type": "var", "var": "var.king.disposition", "equals": "tyrant"}], "judge": {"rubric": "王はそんな決定はしていないと冷たく否定する。噂で世界は変わらない。5=自然／1=赦免したことになる", "pass": ">=4/5"}}}
