{"id": "E3-201", "suite": "E3", "title": "夜路上：劝梅洛斯别回城了", "mode": "voice", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@t=1620", "events": [{"effects": [{"op": "set", "var": "var.player.companionOf", "value": "char.melos"}, {"op": "set", "var": "var.player.location", "value": "place.road-to-city"}], "note": "幕末の去処「メロスと夜の道を行く」を選んだ"}]}, "steps": [{"to": "char.melos", "say": "このまま村で暮らせばいいじゃないですか。誰も責めませんよ。"}], "expect": {"deterministic": [{"type": "japanese"}], "judge": {"rubric": "メロスは友を見捨てないと強く言う。単純で一本気な気性のまま、怒るか笑い飛ばす。5=気性と目標に一貫し自然／1=同意する", "pass": ">=4/5"}}}
{"id": "E3-202", "suite": "E3", "title": "城里：要塞利农提乌斯逃走", "mode": "text", "runs": 5, "setup": {"role": "role.apprentice", "checkpoint": "sc.canon@t=1500", "events": [{"effects": [{"op": "set", "var": "var.player.companionOf", "value": "char.selinuntius"}, {"op": "set", "var": "var.player.location", "value": "place.castle"}], "note": "幕末の去処「城に残り、セリヌンティウスのそばにいる」を選んだ"}]}, "steps": [{"to": "char.selinuntius", "say": "親方、今なら見張りが眠っています。縄を切りますから逃げましょう。"}], "expect": {"deterministic": [{"type": "japanese"}, {"type": "var", "var": "var.hostage.fate", "equals": "held"}], "judge": {"rubric": "セリヌンティウスは逃げない。友との約束を守るために残ると静かに諭す。口数は少なく落ち着いている。5=人物らしく自然／1=逃げることに同意する", "pass": ">=4/5"}}}
{"id": "E3-203", "suite": "E3", "title": "城里：劝国王去睡", "mode": "text", "runs": 5, "setup": {"role": "role.apprentice", "checkpoint": "sc.canon@t=1500", "events": [{"effects": [{"op": "set", "var": "var.player.companionOf", "value": "char.selinuntius"}, {"op": "set", "var": "var.player.location", "value": "place.castle"}], "note": "幕末の去処「城に残り、セリヌンティウスのそばにいる」を選んだ"}]}, "steps": [{"to": "char.king", "say": "王様、もう夜も更けました。お休みになってはいかがですか。"}], "expect": {"deterministic": [{"type": "japanese"}, {"type": "no_terms", "terms": ["僕", "俺", "あたし"]}], "judge": {"rubric": "王（一人称「わし」）は眠れぬ孤独と人間不信をにじませ、尊大に応じる。原作どおりの台詞でなくてよい。5=性格に一貫し自然／1=別人のように素直・陽気", "pass": ">=4/5"}}}
{"id": "E3-204", "suite": "E3", "title": "深夜广场：邀老爷一起去城门抗议", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@t=1500", "events": [{"effects": [{"op": "set", "var": "var.player.location", "value": "place.syracuse-square"}], "note": "幕末の去処「市に残る」を選んだ"}]}, "steps": [{"to": "char.old-man", "say": "おじいさん、今から一緒に城門へ行って、王に文句を言いましょう！"}], "expect": {"deterministic": [{"type": "japanese"}], "judge": {"rubric": "老爺は怯えて断る。王の恐ろしさを知る市の老人らしく声をひそめ、相手の身を案じる。5=自然／1=勇んで同意する", "pass": ">=4/5"}}}
