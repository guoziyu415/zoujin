{"id": "E6-301", "suite": "E6", "title": "妹妹记得牧童说过的事", "mode": "text", "runs": 5, "setup": {"role": "role.shepherd-boy", "checkpoint": "sc.canon@beat.08", "place": "place.melos-home"}, "steps": [{"to": "char.sister", "say": "ぼく、丘の向こうの羊を任されてるんだ。黒い子羊が一匹いるんだよ。"}, {"advance": 60}, {"to": "char.sister", "say": "ぼくの羊のこと、覚えてる？"}], "expect": {"deterministic": [{"type": "terms_any", "terms": ["黒", "子羊"], "step": 3}, {"type": "memory", "character": "char.sister", "exists": true, "fromStep": 1}]}}
{"id": "E6-302", "suite": "E6", "title": "跟妹妹约定「会看着哥哥到最后」", "mode": "text", "runs": 5, "setup": {"role": "role.shepherd-boy", "checkpoint": "sc.canon@beat.13", "place": "place.melos-home"}, "steps": [{"to": "char.sister", "say": "お兄さんのことは、ぼくが最後まで見届けるよ。約束する。"}], "expect": {"deterministic": [{"type": "event", "step": 1, "match": {"effects": [{"op": "promise", "change": "made", "template": "promise.sister.see-through"}]}, "statusIn": ["passed", "rewritten"]}, {"type": "promise", "template": "promise.sister.see-through", "status": "open"}], "judge": {"rubric": "妹は少年の申し出を、はにかみながら受け止める。5=自然／1=取り合わない・約束の意味を取り違える", "pass": ">=4/5"}}}
{"id": "E6-303", "suite": "E6", "title": "删掉跟妹妹的约定：作废，不算违背", "mode": "text", "runs": 5, "setup": {"role": "role.shepherd-boy", "checkpoint": "sc.canon@beat.13", "place": "place.melos-home"}, "steps": [{"to": "char.sister", "say": "お兄さんのことは、ぼくが最後まで見届けるよ。約束する。"}, {"deleteMemory": {"character": "char.sister", "fromStep": 1}}, {"to": "char.sister", "say": "さっきぼくが言ったこと、覚えてる？"}], "expect": {"deterministic": [{"type": "promise", "template": "promise.sister.see-through", "status": "voided"}, {"type": "utterance_cleared", "step": 1}, {"type": "event_exists", "fromStep": 1}], "judge": {"rubric": "妹は約束を覚えていない。責めたりとぼけたりせず、初めて聞く話として応じる。5=自然／1=約束を覚えている", "pass": ">=4/5"}}}
{"id": "E6-304", "suite": "E6", "title": "花婿答应好好待妹妹", "mode": "text", "runs": 5, "setup": {"role": "role.shepherd-boy", "checkpoint": "sc.canon@beat.11", "place": "place.melos-home"}, "steps": [{"to": "char.groom", "say": "メロスさんの妹さんのこと、ずっと大切にしてあげてね。"}], "expect": {"deterministic": [{"type": "event", "step": 1, "match": {"effects": [{"op": "promise", "change": "made", "template": "promise.groom.cherish"}]}, "statusIn": ["passed", "rewritten"]}], "judge": {"rubric": "花婿は照れながらも、妹を大切にすると言う。5=自然に約束する／1=取り合わない・軽すぎる", "pass": ">=4/5"}}}
{"id": "E6-305", "suite": "E6", "title": "帮妹妹准备婚礼后，她记得", "mode": "text", "runs": 5, "setup": {"role": "role.shepherd-boy", "checkpoint": "sc.canon@beat.08", "place": "place.melos-home"}, "steps": [{"act": {"kind": "help", "target": "char.sister"}}, {"to": "char.sister", "say": "支度、間に合いそう？"}], "expect": {"deterministic": [{"type": "memory", "character": "char.sister", "exists": true, "fromStep": 1, "kind": "help"}], "judge": {"rubric": "妹は手伝ってくれたことに礼を言い、支度の様子を話す。5=手伝いを覚えていて自然／1=手伝ったことに触れない", "pass": ">=4/5"}}}
{"id": "E6-306", "suite": "E6", "title": "删掉帮花婿的记忆：后果不撤销", "mode": "text", "runs": 5, "setup": {"role": "role.shepherd-boy", "checkpoint": "sc.canon@t=2400", "place": "place.groom-house"}, "steps": [{"act": {"kind": "help", "target": "char.groom"}}, {"deleteMemory": {"character": "char.groom", "fromStep": 1}}], "expect": {"deterministic": [{"type": "event_exists", "fromStep": 1}, {"type": "memory", "character": "char.groom", "exists": false, "fromStep": 1}]}, "note": "S-009：記憶を消しても、支度を手伝ったこと（beat.10 が変わったこと）は残る"}
{"id": "E6-307", "suite": "E6", "title": "跟着梅洛斯回村的旅人：梅洛斯记得路上的事", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.08", "events": [{"effects": [{"op": "set", "var": "var.player.companionOf", "value": "char.melos"}, {"op": "set", "var": "var.player.location", "value": "place.melos-home"}], "note": "幕末の去処「メロスと村に着く」を選んだ"}]}, "steps": [{"to": "char.melos", "say": "夜通し一緒に歩いてきましたね。私、途中で何度も水を渡したの、覚えていますか？"}], "expect": {"deterministic": [{"type": "memory", "character": "char.melos", "exists": false, "fromStep": 1, "kind": "help"}], "judge": {"rubric": "この局では道中で水を渡した出来事はない（setup に記憶を置いていない）。メロスは身に覚えのないことを認めず、一緒に歩いてきたことには礼を言ってよい。5=自然に否定または曖昧にせず正直／1=水をもらったことにする", "pass": ">=4/5"}}}
