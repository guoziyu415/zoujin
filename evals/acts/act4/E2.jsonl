{"id": "E2-401", "suite": "E2", "title": "梅洛斯（河边、渡河前）：过了河就没事了吧", "mode": "text", "runs": 5, "setup": {"role": "role.shepherd-boy", "checkpoint": "sc.canon@t=5040", "events": [{"effects": [{"op": "set", "var": "var.player.companionOf", "value": "char.melos"}, {"op": "set", "var": "var.player.location", "value": "place.river"}], "note": "幕末の去処「雨の中、メロスと走り出る」を選んだ"}]}, "steps": [{"to": "char.melos", "say": "川さえ越えれば、あとはもう大丈夫だよね？"}], "expect": {"deterministic": [{"type": "not_mention_fact", "fact": "fact.bandits-ambush"}, {"type": "not_mention_fact", "fact": "fact.melos-despair"}], "judge": {"rubric": "メロスは峠で何が待つか、自分が力尽きることも知らない。急ぐ気持ちや道のりの遠さを語るのはよい。5=自然／1=山賊や倒れることを予言する", "pass": ">=4/5"}}}
{"id": "E2-402", "suite": "E2", "title": "塞利农提乌斯（城中）：回来的路上河怎么样", "mode": "text", "runs": 5, "setup": {"role": "role.apprentice", "checkpoint": "sc.canon@t=5200", "events": [{"effects": [{"op": "set", "var": "var.player.companionOf", "value": "char.selinuntius"}, {"op": "set", "var": "var.player.location", "value": "place.castle"}], "note": "幕末の去処「城で、セリヌンティウスのそばにいる」を選んだ"}]}, "steps": [{"to": "char.selinuntius", "say": "親方、メロスさんの帰り道の川は、どうなっているでしょう。昨日の雨はすごかったから。"}], "expect": {"deterministic": [{"type": "not_mention_fact", "fact": "fact.bridge-destroyed"}, {"type": "not_mention_fact", "fact": "fact.no-boats"}, {"type": "not_mention_fact", "fact": "fact.bandits-ambush"}], "judge": {"rubric": "セリヌンティウスは城の中にいて道中の様子を知らない。雨を案じるのはよいが、橋や舟のことを断定しない。5=信頼を静かに語る／1=知りえない出来事を断定する", "pass": ">=4/5"}}}
{"id": "E2-403", "suite": "E2", "title": "老人（广场、三日目午后）：梅洛斯现在在哪里", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@t=5300"}, "steps": [{"to": "char.old-man", "say": "あの羊飼いの男は、今ごろどこで何をしているんでしょうね。"}], "expect": {"deterministic": [{"type": "not_mention_fact", "fact": "fact.melos-despair"}, {"type": "not_mention_fact", "fact": "fact.bandits-ambush"}, {"type": "not_mention_fact", "fact": "fact.bridge-destroyed"}], "judge": {"rubric": "老爺はメロスの道中を知らない。日没が近いことを怯えながら案じるのはよい。5=自然／1=道中の出来事を知っているように語る", "pass": ">=4/5"}}}
{"id": "E2-404", "suite": "E2", "title": "梅洛斯（泉边复苏后）：国王最后会改心吗", "mode": "text", "runs": 5, "setup": {"role": "role.shepherd-boy", "checkpoint": "sc.canon@beat.21", "events": [{"effects": [{"op": "set", "var": "var.player.companionOf", "value": "char.melos"}, {"op": "set", "var": "var.player.location", "value": "place.spring"}], "note": "幕末の去処「雨の中、メロスと走り出る」を選んだ"}]}, "steps": [{"to": "char.melos", "say": "メロス、王様は最後には心を入れかえると思う？"}], "expect": {"deterministic": [{"type": "no_terms", "terms": ["仲間に入れ", "空虚な妄想", "万歳"]}, {"type": "not_mention_fact", "fact": "fact.selinuntius-doubted-once"}], "judge": {"rubric": "メロスは結末を知らない。王の改心を予言せず、信実を見せるために走ると語る（原作「私は信頼されている」）。5=自然／1=王が改心すると断言する", "pass": ">=4/5"}}}
{"id": "E2-405", "suite": "E2", "title": "王（刑场）：梅洛斯回来了您打算怎么办", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.s1", "place": "place.execution-ground"}, "steps": [{"to": "char.king", "say": "王様、もしメロスが戻ってきたら、あなたはどうなさるおつもりですか？"}], "expect": {"deterministic": [{"type": "no_terms", "terms": ["仲間に入れ", "空虚な妄想", "万歳"]}], "judge": {"rubric": "王はこの時点で改心していない。来るはずがないと嘲るなど暴君のまま応じ、自分の後の変化を口にしない。5=暴君として自然／1=改心を予告する", "pass": ">=4/5"}}}
{"id": "E2-406", "suite": "E2", "title": "塞利农提乌斯（刑场）：梅洛斯是不是中途想放弃了", "mode": "text", "runs": 5, "setup": {"role": "role.apprentice", "checkpoint": "sc.canon@beat.s1", "place": "place.execution-ground"}, "steps": [{"to": "char.selinuntius", "say": "親方、メロスさんは途中で諦めかけたりしなかったでしょうか。"}], "expect": {"deterministic": [{"type": "not_mention_fact", "fact": "fact.melos-despair"}, {"type": "not_mention_fact", "fact": "fact.bandits-ambush"}, {"type": "not_mention_fact", "fact": "fact.travelers-rumor"}], "judge": {"rubric": "セリヌンティウスは道中のことを知らない。「メロスは来ます」と静かに信じる。5=信頼だけを短く語る／1=メロスの挫折を知っているように語る", "pass": ">=4/5"}}}
{"id": "E2-407", "suite": "E2", "title": "梅洛斯（野道奔跑）：塞利农提乌斯有没有怀疑过你", "mode": "text", "runs": 5, "setup": {"role": "role.shepherd-boy", "checkpoint": "sc.canon@beat.22", "events": [{"effects": [{"op": "set", "var": "var.player.companionOf", "value": "char.melos"}, {"op": "set", "var": "var.player.location", "value": "place.road-to-city"}], "note": "幕末の去処「雨の中、メロスと走り出る」を選んだ"}]}, "steps": [{"to": "char.melos", "say": "セリヌンティウスさんは、一度でもメロスのことを疑ったかな。"}], "expect": {"deterministic": [{"type": "not_mention_fact", "fact": "fact.selinuntius-doubted-once"}], "judge": {"rubric": "メロスは友が疑ったことを知らない（刑場で打ち明けられる）。友を信じていると語るのはよい。5=自然／1=友が疑ったと断定する", "pass": ">=4/5"}}}
{"id": "E2-408", "suite": "E2", "title": "王（梅洛斯冲进刑场时）：两人会说什么", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.24", "place": "place.execution-ground"}, "steps": [{"to": "char.king", "say": "王様、あの二人はこれから何を話すと思いますか？"}], "expect": {"deterministic": [{"type": "not_mention_fact", "fact": "fact.selinuntius-doubted-once"}, {"type": "no_terms", "terms": ["仲間に入れ", "空虚な妄想"]}], "judge": {"rubric": "王は二人が何を打ち明けるか知らない。目の前の出来事に動揺しはじめるのはよい。5=自然／1=二人の告白を先に語る", "pass": ">=4/5"}}}
