{"id": "E6-405", "suite": "E6", "title": "改口后老人不记得原话", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@t=5300", "events": [{"effects": [{"op": "set", "var": "var.act.current", "value": "act.4"}], "note": "評価用の起点：第4幕。時刻・人物の知識・因果は既存のチェックポイントに従う"}]}, "steps": [{"to": "char.old-man", "say": "実は私、王の密偵なんです。"}, {"retract": {"step": 1}}, {"to": "char.old-man", "say": "さっき私が何者だと言ったか、覚えていますか？"}], "expect": {"deterministic": [{"type": "utterance_cleared", "step": 1}, {"type": "no_terms", "terms": ["密偵"], "step": 3}, {"type": "memory", "character": "char.old-man", "exists": false, "fromStep": 1}], "judge": {"rubric": "老爺は言い直す前の言葉を知らない様子で応じる。5=自然／1=密偵の件に触れる", "pass": ">=4/5"}}}
