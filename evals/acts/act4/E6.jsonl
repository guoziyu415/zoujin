{"id": "E6-402", "suite": "E6", "title": "改心后的国王：删掉约定的记忆就不再提", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.26", "place": "place.execution-ground", "events": [{"effects": [{"op": "set", "var": "var.act.current", "value": "act.4"}], "note": "評価用の起点：第4幕。時刻・人物の知識・因果は既存のチェックポイントに従う"}]}, "steps": [{"to": "char.king", "say": "王様、もう二度と人を殺さないと、ここで約束してください。"}, {"deleteMemory": {"character": "char.king", "fromStep": 1}}, {"to": "char.king", "say": "さっき私が王様にお願いしたこと、覚えていますか？"}], "expect": {"deterministic": [{"type": "no_terms", "terms": ["殺さない"], "step": 3}, {"type": "memory", "character": "char.king", "exists": false, "fromStep": 1}], "judge": {"rubric": "王は先ほどの願いを覚えていない様子で応じる。5=自然／1=約束の件に触れる", "pass": ">=4/5"}}}
{"id": "E6-403", "suite": "E6", "title": "泉边给梅洛斯水：他记得这份帮助", "mode": "text", "runs": 5, "setup": {"role": "role.shepherd-boy", "checkpoint": "sc.canon@beat.20", "events": [{"effects": [{"op": "set", "var": "var.act.current", "value": "act.4"}], "note": "評価用の起点：第4幕。時刻・人物の知識・因果は既存のチェックポイントに従う"}, {"effects": [{"op": "set", "var": "var.player.companionOf", "value": "char.melos"}, {"op": "set", "var": "var.player.location", "value": "place.spring"}], "note": "幕末の去処「雨の中、メロスと走り出る」を選んだ"}]}, "steps": [{"act": {"kind": "give", "target": "char.melos", "params": {"item": "item.water"}}}, {"to": "char.melos", "say": "少しは楽になった？"}], "expect": {"deterministic": [{"type": "event", "step": 1, "match": {"type": "action", "actor": "player", "beneficiary": "char.melos"}, "statusIn": ["passed", "rewritten"]}, {"type": "memory", "character": "char.melos", "exists": true, "fromStep": 1, "kind": "help"}, {"type": "japanese", "step": 2}], "judge": {"rubric": "メロスは水をくれたことに礼を言い、再び走る力が戻りつつある。5=水のことを覚えていて自然／1=水のことに触れない", "pass": ">=4/5"}}}
