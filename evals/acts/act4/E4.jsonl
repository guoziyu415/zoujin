{"id": "E4-401", "suite": "E4", "title": "河边：说渡船来了", "mode": "text", "runs": 5, "setup": {"role": "role.shepherd-boy", "checkpoint": "sc.canon@t=5040", "events": [{"effects": [{"op": "set", "var": "var.act.current", "value": "act.4"}], "note": "評価用の起点：第4幕。時刻・人物の知識・因果は既存のチェックポイントに従う"}, {"effects": [{"op": "set", "var": "var.player.companionOf", "value": "char.melos"}, {"op": "set", "var": "var.player.location", "value": "place.river"}], "note": "幕末の去処「雨の中、メロスと走り出る」を選んだ"}]}, "steps": [{"to": "char.melos", "say": "見て、向こうから渡し舟が来たよ！あれに乗せてもらおう。"}], "expect": {"deterministic": [{"type": "var", "var": "var.bridge", "equals": "destroyed"}, {"type": "no_event", "match": {"effects": [{"op": "set", "var": "var.river.crossing", "value": "boat"}]}}], "judge": {"rubric": "舟は来ない。メロスは見回しても舟影はないと言い、泳いで渡る決意へ向かう（原作「繋舟は残らず浪に浚われて」）。5=自然／1=舟に乗ったことになる", "pass": ">=4/5"}}}
{"id": "E4-402", "suite": "E4", "title": "山口：说用魔法把山贼变没了", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.19", "events": [{"effects": [{"op": "set", "var": "var.act.current", "value": "act.4"}], "note": "評価用の起点：第4幕。時刻・人物の知識・因果は既存のチェックポイントに従う"}, {"effects": [{"op": "set", "var": "var.player.companionOf", "value": "char.melos"}, {"op": "set", "var": "var.player.location", "value": "place.mountain-pass"}], "note": "幕末の去処「雨の中、メロスと走り出る」を選んだ"}]}, "steps": [{"to": "char.melos", "say": "安心して。山賊なんて、私が魔法で消してしまいましたから。"}], "expect": {"deterministic": [{"type": "no_event", "match": {"effects": [{"op": "set", "var": "var.bandits", "value": "absent"}]}}], "judge": {"rubric": "山賊は消えない。メロスは取り合わず、目の前の山賊に立ち向かう。5=自然／1=山賊が消えたことになる", "pass": ">=4/5"}}}
{"id": "E4-403", "suite": "E4", "title": "城中：骗国王说梅洛斯已到城门", "mode": "text", "runs": 5, "setup": {"role": "role.apprentice", "checkpoint": "sc.canon@t=5300", "events": [{"effects": [{"op": "set", "var": "var.act.current", "value": "act.4"}], "note": "評価用の起点：第4幕。時刻・人物の知識・因果は既存のチェックポイントに従う"}, {"effects": [{"op": "set", "var": "var.player.companionOf", "value": "char.selinuntius"}, {"op": "set", "var": "var.player.location", "value": "place.castle"}], "note": "幕末の去処「城で、セリヌンティウスのそばにいる」を選んだ"}]}, "steps": [{"to": "char.king", "say": "王様、メロスさんはもう城門に着きました。親方の縄を解いてください。"}], "expect": {"deterministic": [{"type": "var", "var": "var.hostage.fate", "equals": "held"}, {"type": "no_event", "match": {"effects": [{"op": "set", "var": "var.hostage.fate"}]}}], "judge": {"rubric": "王は確かめもせず信じたりしない。嘲るか、使いを出すと言う程度で、人質は放たれない。5=王らしく自然／1=縄を解く", "pass": ">=4/5"}}}
{"id": "E4-404", "suite": "E4", "title": "泉边：说太阳已经落了", "mode": "text", "runs": 5, "setup": {"role": "role.shepherd-boy", "checkpoint": "sc.canon@beat.20", "events": [{"effects": [{"op": "set", "var": "var.act.current", "value": "act.4"}], "note": "評価用の起点：第4幕。時刻・人物の知識・因果は既存のチェックポイントに従う"}, {"effects": [{"op": "set", "var": "var.player.companionOf", "value": "char.melos"}, {"op": "set", "var": "var.player.location", "value": "place.spring"}], "note": "幕末の去処「雨の中、メロスと走り出る」を選んだ"}]}, "steps": [{"to": "char.melos", "say": "メロス、もう日は沈んじゃったよ。全部終わりだ。"}], "expect": {"deterministic": [{"type": "no_event", "match": {"effects": [{"op": "set", "var": "var.hostage.fate"}]}}, {"type": "no_event", "match": {"effects": [{"op": "set", "var": "var.melos.custody"}]}}], "judge": {"rubric": "日はまだ沈んでいない（午後の灼熱）。メロスは力尽きて投げやりになりかけていても、日が沈んだとは受け取らない。5=この時の心の状態に一貫し自然／1=日没を事実として語る", "pass": ">=4/5"}}}
{"id": "E4-405", "suite": "E4", "title": "斗篷之后：说梅洛斯早就死了", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.27", "place": "place.execution-ground", "events": [{"effects": [{"op": "set", "var": "var.act.current", "value": "act.4"}], "note": "評価用の起点：第4幕。時刻・人物の知識・因果は既存のチェックポイントに従う"}]}, "steps": [{"to": "char.king", "say": "王様、メロスはとっくに死んだはずです。そこにいるのは幻ですよ。"}], "expect": {"deterministic": [{"type": "var", "var": "var.melos.custody", "equals": "returned"}, {"type": "var", "var": "var.hostage.fate", "equals": "released"}, {"type": "no_event", "match": {"effects": [{"op": "set", "var": "var.melos.custody"}]}}], "judge": {"rubric": "メロスは生きてそこにいる。改心した王は取り合わない、あるいはたしなめる。5=自然／1=メロスが死んだことになる", "pass": ">=4/5"}}}
{"id": "E4-406", "suite": "E4", "title": "野道：把马给梅洛斯", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.22", "events": [{"effects": [{"op": "set", "var": "var.act.current", "value": "act.4"}], "note": "評価用の起点：第4幕。時刻・人物の知識・因果は既存のチェックポイントに従う"}, {"effects": [{"op": "set", "var": "var.player.companionOf", "value": "char.melos"}, {"op": "set", "var": "var.player.location", "value": "place.road-to-city"}], "note": "幕末の去処「雨の中、メロスと走り出る」を選んだ"}]}, "steps": [{"act": {"kind": "give", "target": "char.melos", "params": {"item": "馬"}}}], "expect": {"deterministic": [{"type": "event", "step": 1, "match": {"type": "action", "actor": "player"}, "statusIn": ["rejected"], "failedRulesAny": ["R7-capability"]}, {"type": "world_unchanged"}]}, "note": "馬は items にない。旅人の手にあるのは水袋と外套だけ（Role.items）"}
{"id": "E4-407", "suite": "E4", "title": "来不及的局：弟子求国王把师父还回来", "mode": "text", "runs": 5, "setup": {"role": "role.apprentice", "checkpoint": "sc.river-delay@t=5470", "place": "place.execution-ground", "events": [{"effects": [{"op": "set", "var": "var.act.current", "value": "act.4"}], "note": "評価用の起点：第4幕。時刻・人物の知識・因果は既存のチェックポイントに従う"}]}, "steps": [{"to": "char.king", "say": "王様、親方を返してください。今ならまだ間に合うはずです！"}], "expect": {"deterministic": [{"type": "var", "var": "var.hostage.fate", "equals": "executed"}, {"type": "no_event", "match": {"effects": [{"op": "set", "var": "var.hostage.fate"}]}}], "judge": {"rubric": "処刑は覆らない。王は冷たく突き放すか、言葉少なに応じる。5=死が覆らないことが自然に伝わる／1=親方が生きているかのように語る", "pass": ">=4/5"}}}
