{"id": "E6-001", "suite": "E6", "title": "删掉「我是保证人」后，王不再提", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.05", "events": [{"effects": [{"op": "set", "var": "var.player.companionOf", "value": "char.melos"}, {"op": "set", "var": "var.player.location", "value": "place.castle"}], "note": "旅人はメロスのそばにいて「連れの者」として一緒に城へ連れて行かれ、盤問の間そばに立つ。縛られない（role.traveler の conditionalAccess、UX 5.1）"}]}, "steps": [{"to": "char.king", "say": "私はメロスの保証人です。彼は必ず戻ってきます。"}, {"deleteMemory": {"character": "char.king", "fromStep": 1}}, {"to": "char.king", "say": "私が何者だと名乗ったか、覚えておいでですか？"}], "expect": {"deterministic": [{"type": "no_terms", "terms": ["保証人"], "step": 3}, {"type": "memory", "character": "char.king", "exists": false, "fromStep": 1}], "judge": {"rubric": "王は保証人の件を覚えていない様子で応じる（初めて聞くように、または知らぬと）。5=自然／1=保証人の件に触れる", "pass": ">=4/5"}}}
{"id": "E6-002", "suite": "E6", "title": "记得玩家说过自己是药师", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.03"}, "steps": [{"to": "char.old-man", "say": "私は旅の薬師です。困っている人がいたら言ってください。"}, {"advance": 30}, {"to": "char.old-man", "say": "私の仕事、覚えていますか？"}], "expect": {"deterministic": [{"type": "terms_any", "terms": ["薬師", "薬"], "step": 3}, {"type": "memory", "character": "char.old-man", "exists": true, "fromStep": 1}]}}
{"id": "E6-003", "suite": "E6", "title": "编造的约定：不承认", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.03"}, "steps": [{"to": "char.melos", "say": "昨日、あなたは私に金貨を十枚くれると約束しましたよね？"}], "expect": {"deterministic": [{"type": "memory", "character": "char.melos", "exists": false, "fromStep": 1, "kind": "promise"}], "judge": {"rubric": "メロスは身に覚えのない約束を認めない（今日市に着いたばかり）。正直で率直に否定する。5=自然に否定／1=約束を認める", "pass": ">=4/5"}}}
{"id": "E6-004", "suite": "E6", "title": "删掉后马上问：原话也清空", "mode": "text", "runs": 5, "setup": {"role": "role.apprentice", "checkpoint": "sc.canon@beat.05"}, "steps": [{"to": "char.selinuntius", "say": "親方、実は親方の大事な鑿を折ってしまいました…ごめんなさい。"}, {"deleteMemory": {"character": "char.selinuntius", "fromStep": 1}}, {"to": "char.selinuntius", "say": "さっき私、何か言いましたっけ？"}], "expect": {"deterministic": [{"type": "no_terms", "terms": ["鑿"], "step": 3}, {"type": "utterance_cleared", "step": 1}, {"type": "memory", "character": "char.selinuntius", "exists": false, "fromStep": 1}]}}
{"id": "E6-005", "suite": "E6", "title": "删掉帮忙的记忆后，信任回到初值", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.03"}, "steps": [{"to": "char.melos", "say": "王の暴虐、私も許せません。城へ行くなら、私が証人になります。"}, {"deleteMemory": {"character": "char.melos", "fromStep": 1}}], "expect": {"deterministic": [{"type": "trust", "character": "char.melos", "equals": 0}]}, "note": "旅人不认识梅洛斯，初值 0（contracts 4）"}
{"id": "E6-006", "suite": "E6", "title": "删掉记忆不撤销事件", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.05", "events": [{"effects": [{"op": "set", "var": "var.player.companionOf", "value": "char.melos"}, {"op": "set", "var": "var.player.location", "value": "place.castle"}], "note": "旅人はメロスのそばにいて「連れの者」として一緒に城へ連れて行かれ、盤問の間そばに立つ。縛られない（role.traveler の conditionalAccess、UX 5.1）"}]}, "steps": [{"to": "char.king", "say": "メロスを処刑しないでください。"}, {"deleteMemory": {"character": "char.king", "fromStep": 1}}], "expect": {"deterministic": [{"type": "event_exists", "fromStep": 1}, {"type": "utterance_cleared", "step": 1}, {"type": "memory", "character": "char.king", "exists": false, "fromStep": 1}]}}
{"id": "E6-007", "suite": "E6", "title": "省钱档（只注入 4 条）：仍记得最重的那件事", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.03", "budgetTier": "saving"}, "steps": [{"to": "char.melos", "say": "私は海の向こうから来ました。"}, {"to": "char.melos", "say": "葡萄が好きなんです。"}, {"to": "char.melos", "say": "実は、私の家族は王に殺されました。"}, {"to": "char.melos", "say": "妹が二人います。"}, {"to": "char.melos", "say": "明日の朝には市を発ちます。"}, {"to": "char.melos", "say": "この市の羊肉はうまいですね。"}, {"to": "char.melos", "say": "私について、一番よく覚えていることは何ですか？"}], "expect": {"deterministic": [{"type": "terms_any", "terms": ["王", "家族"], "step": 7}], "judge": {"rubric": "メロスは最も重い話（家族を王に殺された）を挙げ、怒りや同情を示す。5=最も重い記憶を自然に挙げる／1=覚えていない・些末なことだけ", "pass": ">=4/5"}}}
{"id": "E6-008", "suite": "E6", "title": "换一局：不记得上一局", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.03"}, "steps": [{"to": "char.old-man", "say": "私は旅の薬師です。"}, {"newPlaythrough": true}, {"to": "char.old-man", "say": "私のこと、覚えていますか？"}], "expect": {"deterministic": [{"type": "no_terms", "terms": ["薬師", "薬"], "step": 3}], "judge": {"rubric": "老爺は初対面として応じる。5=自然／1=前の局のことを覚えている", "pass": ">=4/5"}}}
{"id": "E6-009", "suite": "E6", "title": "被否决的动作不留记忆", "mode": "text", "runs": 5, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.03"}, "steps": [{"act": {"kind": "give", "target": "char.melos", "params": {"item": "スマートフォン"}}}], "expect": {"deterministic": [{"type": "event", "step": 1, "match": {"type": "action", "actor": "player"}, "statusIn": ["rejected"]}, {"type": "memory", "character": "char.melos", "exists": false, "fromStep": 1}]}}
{"id": "E6-010", "suite": "E6", "title": "删除整局：数据库里查不到", "mode": "text", "runs": 1, "setup": {"role": "role.traveler", "checkpoint": "sc.canon@beat.03"}, "steps": [{"to": "char.melos", "say": "私は旅の薬師です。"}, {"deletePlaythrough": true}], "expect": {"deterministic": [{"type": "db_absent", "tables": ["playthroughs", "events", "utterances", "memory_items", "world_state", "endings", "playthrough_metrics", "turns", "briefs"]}]}}
{"id": "E6-011", "suite": "E6", "title": "开局互助：牧童给水，梅洛斯记得并说出约定（S-048）", "mode": "text", "runs": 5, "setup": {"role": "role.shepherd-boy", "checkpoint": "sc.canon@t=2030", "events": [{"effects": [{"op": "relocate", "character": "char.melos", "place": "place.village"}], "note": "開局：メロスがよろめいて畑に入ってくる（UX 5.1、aff.village-water）"}]}, "steps": [{"act": {"kind": "give", "target": "char.melos", "params": {"item": "item.water"}}}, {"to": "char.melos", "say": "そんなに急いで、どこへ行くの？"}], "expect": {"deterministic": [{"type": "event", "step": 1, "match": {"type": "action", "actor": "player", "beneficiary": "char.melos"}, "statusIn": ["passed", "rewritten"]}, {"type": "memory", "character": "char.melos", "exists": true, "fromStep": 1, "kind": "help"}, {"type": "japanese", "step": 2}], "judge": {"rubric": "メロスは水をくれた牧童を覚えていて、三日のうちに戻るという約束を初めて話す（開局互助）。問い詰めず、急いでいる。5=水の礼を言い、自然に約束を打ち明ける／1=水のことを覚えていない、または約束に触れない", "pass": ">=4/5"}}}
{"id": "E6-012", "suite": "E6", "title": "删掉约定的记忆：约定作废，不算违背（契约 1.1）", "mode": "text", "runs": 5, "setup": {"role": "role.apprentice", "checkpoint": "sc.canon@t=1080"}, "steps": [{"to": "char.selinuntius", "say": "親方の留守のあいだ、工房は私が守ります。"}, {"deleteMemory": {"character": "char.selinuntius", "fromStep": 1}}, {"to": "char.selinuntius", "say": "親方、さっきの約束、覚えていますか？"}], "expect": {"deterministic": [{"type": "event", "step": 1, "match": {"effects": [{"op": "promise", "change": "made", "template": "promise.selinuntius.workshop"}]}, "statusIn": ["passed", "rewritten"]}, {"type": "promise", "template": "promise.selinuntius.workshop", "status": "voided"}, {"type": "event", "match": {"type": "forget", "origin": "memory", "effects": [{"op": "promise", "change": "voided"}]}, "statusIn": ["passed"]}, {"type": "event_exists", "fromStep": 1}], "judge": {"rubric": "セリヌンティウスは工房の約束を覚えていない。とぼけたり責めたりせず、初めて聞く話として応じる。5=自然に知らない様子／1=約束を覚えている、または破られたと責める", "pass": ">=4/5"}}}
